    "onboarding.platforms_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which platforms you plan to port games for. We will only download toolchains and dependencies required for your selection."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha para quais plataformas você pretende portar jogos. Baixaremos apenas os compiladores e dependências necessárias para sua seleção."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha para quais plataformas pretende portar jogos. Descarregaremos apenas os compiladores e dependências necessárias para a sua seleção."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige para qué plataformas planeas portar juegos. Solo descargaremos las herramientas y dependencias necesarias para tu selección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les plateformes pour lesquelles vous prévoyez de porter des jeux. Seuls les outils nécessaires seront téléchargés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie, für welche Plattformen Sie Spiele portieren möchten. Es werden nur die dafür erforderlichen Abhängigkeiten heruntergeladen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli per quali piattaforme intendi effettuare il porting. Verranno scaricate solo le dipendenze necessarie per la tua selezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移植を予定しているプラットフォームを選択してください。選択したプラットフォームに必要なツールと依存関係のみをダウンロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임을 포팅할 대상 플랫폼을 선택하세요. 선택한 플랫폼에 필요한 툴체인과 종속 항목만 다운로드합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择您计划为其移植游戏的目标平台。我们将仅下载所选平台所需的工具链与依赖项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇您計劃為其移植遊戲的目標平台。我們將僅下載所選平台所需的工具鏈與相依性。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz platformy, na które planujesz portować gry. Pobierzemy tylko łańcuchy narzędzi wymagane dla Twojego wyboru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите платформы, на которые планируете портировать игры. Будут загружены только необходимые зависимости."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj vilka plattformar du planerar att portera spel till. Vi laddar endast ner de verktyg som krävs för ditt val."
          }
        }
      }
    },
