    "library.remove_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel wird aus dem Tab Meine Spiele entfernt. Die Spieldateien bleiben sicher auf dem Datenträger erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game will be removed from your library tab. Its files will remain safely on disk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego se quitará de la pestaña Mis Juegos. Sus archivos permanecerán en el disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu sera retiré de l'onglet Mes Jeux. Ses fichiers resteront intacts sur le disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gioco verrà rimosso dalla scheda I miei giochi. I suoi file rimarranno al sicuro sul disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームは「マイゲーム」タブから削除されます。ファイルはディスク上に安全に保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
