    "build.update_locked_during_build": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository-Updates werden während des Builds pausiert, um Toolchain- und Shader-Diskrepanzen zu verhindern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository updates are paused while a build is in progress to prevent toolchain and shader hash mismatch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones del repositorio se pausan durante la compilación para evitar discrepancias en la cadena de herramientas y shaders."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour du dépôt sont suspendues pendant la compilation pour éviter tout décalage d'outils et de shaders."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli aggiornamenti del repository sono sospesi durante la compilazione per evitare incompatibilità di toolchain e shader."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールチェーンとシェーダーの不整合を防ぐため、ビルド実行中はリポジトリの更新が一時停止されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "툴체인 및 셰이더 해시 불일치를 방지하기 위해 빌드 중에는 저장소 업데이트가 일시정지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizacje repozytorium są wstrzymane podczas kompilacji, aby zapobiec niezgodnościom narzędzi i shaderów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizações do repositório estão pausadas durante a compilação para evitar inconsistência de compilação e shaders."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As atualizações do repositório estão em pausa durante a compilação para evitar inconsistências no compilador e shaders."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновление репозитория приостановлено во время сборки для предотвращения конфликтов тулчейна и шейдеров."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkivuppdateringar pausas medan bygge pågår för att förhindra verktygskedje- och shader-avvikelser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编译正在进行中，已暂停存储库更新以避免工具链与着色器哈希冲突。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編譯進行中，已暫停存放庫更新以避免工具鏈與著色器雜湊衝突。"
          }
        }
      }
    },
