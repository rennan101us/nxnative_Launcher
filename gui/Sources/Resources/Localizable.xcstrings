    "controls.title_screen_tip_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast alle Switch-Spiele erfordern das gleichzeitige Drücken von L + R auf dem Titelbildschirm, um den Controller zu erkennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearly all Switch games require you to press L + R simultaneously on the title screen to detect and pair your controller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi todos los juegos de Switch requieren presionar L + R simultáneamente en la pantalla inicial para detectar el mando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presque tous les jeux Switch nécessitent d'appuyer simultanément sur L + R à l'écran titre pour détecter et associer la manette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quasi tutti i giochi Switch richiedono di premere contemporaneamente L + R nella schermata iniziale per rilevare il controller."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほとんどすべてのSwitchタイトルは、タイトル画面でコントローラーを認識させるために L + R の同時押しが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거의 모든 Switch 게임은 타이틀 화면에서 컨트롤러를 인식하고 등록하기 위해 L + R 동시 입력이 필요합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prawie wszystkie gry Switch wymagają jednoczesnego naciśnięcia L + R na ekranie tytułowym, aby wykryć kontroler."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quase todos os jogos de Switch exigem pressionar L + R simultaneamente na tela inicial para detectar e parear o controle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quase todos os jogos de Switch exigem pressionar L + R em simultâneo no ecrã inicial para detetar e emparelhar o comando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почти все игры Switch требуют одновременного нажатия L + R на титульном экране для определения и подключения контроллера."
          }
        },
        "sv": {
