    "settings_modal.team_has_cert_notice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktives Entwicklungszertifikat im Schlüsselbund gefunden. Die App wird signiert und romfs.img direkt via devicectl übertragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active development certificate found in Keychain. The app will be signed and romfs.img transferred directly via devicectl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificado de desarrollo activo encontrado en el llavero. La app se firmará y romfs.img se transferirá directamente vía devicectl."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificat de développement actif trouvé dans le trousseau. L'application sera signée et romfs.img transféré directement via devicectl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificato di sviluppo attivo trovato nel Portachiavi. L'app verrà firmata e romfs.img trasferito direttamente via devicectl."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーチェーンに有効な開発者証明書が見つかりました。アプリが署名され、romfs.img が直接転送されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키체인에서 유효한 개발 인증서를 찾았습니다. 앱이 서명되고 devicectl을 통해 직접 전송됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znaleziono aktywny certyfikat deweloperski w pęku kluczy. Aplikacja zostanie podpisana, a romfs.img przesłany przez devicectl."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificado de desenvolvimento ativo no Chaveiro. O app será assinado e o romfs.img transferido diretamente via devicectl."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificado de desenvolvimento ativo no Chaveiro. O app será assinado e o romfs.img transferido diretamente via devicectl."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найден активный сертификат разработчика. Приложение будет подписано, а romfs.img передан через devicectl."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivt utvecklarcertifikat hittades i nyckelringen. Appen signeras och överförs direkt via devicectl."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在钥匙串中找到有效的开发者证书。应用将自动签名并直接通过 devicectl 传输 romfs.img。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在鑰匙圈中找到有效的開發者憑證。應用程式將自動簽名並直接透過 devicectl 傳輸 romfs.img。"
          }
        }
      }
    },
    "settings_modal.team_no_cert_notice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Team hat noch kein Entwicklungszertifikat: Xcode erstellt es bei der ersten Installation. Xcode signiert das Spiel und überträgt die Daten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This team has no development certificate yet: Xcode creates it at the first install (the Mac needs to be online). Xcode signs the game for this device and installs it there, then copies the game data (romfs.img) into the app's Documents, as for sideloading; the first copy of a large game takes a few minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este equipo aún no tiene certificado de desarrollo: Xcode lo crea en la primera instalación (el Mac debe estar conectado a internet). Xcode firma el juego e instala en el dispositivo, luego copia los datos (romfs.img) a Documents de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette équipe n'a pas encore de certificat de développement : Xcode le crée lors de la première installation. Xcode signe le jeu et l'installe sur l'appareil, puis copie les données (romfs.img) vers Documents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo team non ha ancora un certificato di sviluppo: Xcode lo crea alla prima installazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチームにはまだ開発者証明書がありません。初回のインストール時に Xcode が作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 팀에는 개발 인증서가 없습니다. 최초 설치 시 Xcode가 자동으로 생성합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten zespół nie ma jeszcze certyfikatu: Xcode utworzy go przy pierwszej instalacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta equipe ainda não possui um certificado de desenvolvimento: o Xcode o cria na primeira instalação (o Mac precisa estar online). O Xcode assina o jogo para este dispositivo e o instala, em seguida copia os dados do jogo (romfs.img) para a pasta Documents do app. A primeira cópia de um jogo grande leva alguns minutos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta equipa ainda não possui um certificado de desenvolvimento: o Xcode o cria na primeira instalação (o Mac precisa estar online). O Xcode assina o jogo para este dispositivo e o instala, em seguida copia os dados do jogo (romfs.img) para a pasta Documents do app. A primeira cópia de um jogo grande leva alguns minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этой команды еще нет сертификата: Xcode создаст его при первой установке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta team har inget utvecklarcertifikat än: Xcode skapar det vid första installationen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该团队尚未创建开发者证书：Xcode 将在首次安装时自动创建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該團隊尚未建立開發者憑證：Xcode 將在首次安裝時自動建立。"
          }
        }
      }
    },
    "shader.completed_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Shader-Pipelines wurden kompiliert und im Cache gespeichert. Das Spiel läuft nun mit flüssigen 60 FPS!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All shader pipelines have been compiled and cached. Your game will now run at smooth 60 FPS!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los shaders han sido compilados y guardados en caché. ¡Su juego funcionará ahora a 60 FPS fluidos!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les pipelines de shaders ont été compilés et mis en cache. Votre jeu tourne désormais à 60 FPS fluides !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le pipeline di shader sono state compilate e memorizzate nella cache. Il gioco ora funzionerà a 60 FPS fluidi!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのシェーダーパイプラインがコンパイルされキャッシュされました。ゲームは滑らかな60 FPSで動作します！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 셰이더 파이프라인이 컴파일되어 캐시되었습니다. 게임이 이제 부드러운 60 FPS로 실행됩니다!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie shadery zostały skompilowane i zapisane w pamięci podręcznej. Gra będzie działać w płynnych 60 FPS!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os shaders foram compilados e salvos em cache. O jogo agora rodará a 60 FPS fluidos!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
