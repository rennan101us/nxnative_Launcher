    "controls.mouse_right_stick_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überträgt Mausbewegungen auf den rechten Analogstick (ideal zum Zielen und für Kamerasteuerung in Zelda, Mario Odyssey, NieR usw.)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maps mouse movement to the right analog stick (ideal for aiming and camera control in Zelda, Mario Odyssey, NieR, etc.)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapea el movimiento del ratón al stick analógico derecho (ideal para apuntar y controlar la cámara en Zelda, Mario Odyssey, NieR, etc.)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associe le mouvement de la souris au stick analogique droit (idéal pour viser et orienter la caméra dans Zelda, Mario Odyssey, NieR, etc.)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappa il movimento del mouse sulla levetta analogica destra (ideale per mirare e gestire la telecamera in Zelda, Mario Odyssey, NieR, ecc.)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスの動きを右アナログスティックに割り当てます (ゼルダ、マリオオデッセイ、NieR などの視点操作に最適)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 움직임을 오른쪽 아날로그 스틱에 매핑합니다 (젤다, 마리오 오디세이, 니어 등의 시점 제어에 최적)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapuje ruch myszy na prawy drążek analogowy (idealne do celowania i kamery w Zelda, Mario Odyssey, NieR itp.)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapeia o movimento do mouse para o stick direito no jogo (ideal para mirar e controlar a câmera em Zelda, Mario Odyssey, NieR, etc.)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapeia o movimento do rato para o stick direito no jogo (ideal para mirar e controlar a câmara em Zelda, Mario Odyssey, NieR, etc.)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назначает движение мыши на правый аналоговый стик (идеально для прицеливания в Zelda, Mario Odyssey, NieR и др.)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopplar musrörelser till höger analogspak (perfekt för att sikta och styra kameran i Zelda, Mario Odyssey, NieR osv.)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将鼠标移动映射到右摇杆 (非常适合在塞尔达、马力欧奥德赛、尼尔等游戏中瞄准和控制视角)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將滑鼠移動對應到右搖桿 (非常適合在薩爾達、瑪利歐奧德賽、尼爾等遊戲中瞄準與控制視角)。"
          }
        }
      }
    },
