            "state": "translated",
            "value": "Patch preconfigurate per sblocco a 60 FPS, allocatori memoria UE, fallback shader e pacchettizzazione Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "60 FPS解放、UEメモリアロケータ、動的シェーダー代替、Macアプリパッケージ用の設定済みパッチ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "60 FPS 해제, UE 메모리 할당자, 동적 셰이더 폴백 및 Mac 앱 패키징을 위한 사전 구성된 패치입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstępnie skonfigurowane łatki do odblokowania 60 FPS, alokatorów pamięci UE i pakowania aplikacji Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Patches pré-configurados para desbloqueio de 60 FPS, alocadores UE, fallbacks de shaders e empacotamento Mac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Patches pré-configurados para desbloqueio de 60 FPS, alocadores UE, fallbacks de shaders e empacotamento Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предустановленные патчи для разблокировки 60 FPS, аллокаторов UE, шейдеров и сборки Mac-приложений."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förkonfigurerade patchar för 60 FPS-upplåsning, UE-minnesallokerare, dynamiska reservlösningar för shaders och paketering av Mac-appar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
