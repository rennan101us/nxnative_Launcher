    "system.app_support_folder_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicherort für Spielstände, Protokolle und Konfigurationen. Standardmäßig ~/Library/Application Support/nxnative."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where save files, logs, and game configurations are kept. Defaults to standard ~/Library/Application Support/nxnative for Time Machine and daily backup compatibility."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Donde se almacenan las partidas guardadas, registros y configuraciones. Predeterminado en ~/Library/Application Support/nxnative."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emplacement des sauvegardes, journaux et configurations de jeu. Par défaut ~/Library/Application Support/nxnative."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posizione per salvataggi, registri e configurazioni. Predefinito in ~/Library/Application Support/nxnative."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セーブデータ、ログ、ゲーム設定の保存先です。Time Machineバックアップ対応のため ~/Library/Application Support/nxnative が標準です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세이브 파일, 로그 및 설정이 보관되는 위치입니다. Time Machine 백업 호환을 위해 ~/Library/Application Support/nxnative가 기본값입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miejsce przechowywania zapisów gier, dzienników i konfiguracji. Domyślnie ~/Library/Application Support/nxnative."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
