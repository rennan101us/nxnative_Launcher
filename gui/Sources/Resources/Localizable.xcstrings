    "ipa_health.hub_stale_banner_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Veraltete Hub-Einträge (%@) erfordern Hintergrundkompilierung vor Installation. Veraltete Einträge entfernen oder aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outdated Hub entries (%@) force NxN Launcher to recompile them in the background before installing. Remove stale entries from Hub or update them explicitly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las entradas obsoletas del Hub (%@) obligan a recompilarlas en segundo plano. Elimina las entradas antiguas o actualízalas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les entrées obsolètes (%@) forcent une recompilation en arrière-plan. Supprimez ou mettez à jour ces jeux dans le Hub."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voci obsolete (%@) richiedono ricompilazione in background. Rimuovile o aggiornale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古い Hub エントリ (%@) はインストール前にバックグラウンドで再コンパイルを強制します。古い項目を削除するか更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구버전 Hub 항목(%@)은 백그라운드 재컴파일을 강제합니다. 오래된 항목을 제거하거나 업데이트하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieaktualne wpisy (%@) wymuszają kompilację w tle. Usuń stare wpisy z Huba lub zaktualizuj je."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entradas antigas no Hub (%@) obrigam recompilação em segundo plano antes do envio. Remova os antigos do Hub ou atualize-os explicitamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Entradas antigas no Hub (%@) obrigam recompilação em segundo plano antes do envio. Remova os antigos do Hub ou atualize-os explicitamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устаревшие игры (%@) требуют перекомпиляции перед установкой. Удалите их из Hub или обновите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Föråldrade poster (%@) tvingar fram bakgrundskompilering. Ta bort eller uppdatera dem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过期的 Hub 条目 (%@) 在安装前会强制在后台重新编译。请从 Hub 移除旧条目或主动更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過期的 Hub 項目 (%@) 在安裝前會強制在背景重新編譯。請從 Hub 移除舊項目或主動更新。"
          }
        }
      }
    },
