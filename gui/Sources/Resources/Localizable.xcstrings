            "state": "translated",
            "value": "Donne la priorité aux performances CPU et GPU sur Apple Silicon, réduisant la latence des manettes et de l'audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dà priorità alle prestazioni di CPU e GPU su Apple Silicon, riducendo la latenza di controller e audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Silicon 上で CPU と GPU のパフォーマンスを優先し、コントローラーと音声の遅延を低減します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Silicon에서 CPU 및 GPU 성능을 최우선으로 지정하여 컨트롤러 및 오디오 지연 시간을 줄입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorytetyzuje wydajność CPU i GPU na Apple Silicon, zmniejszając opóźnienia kontrolera i dźwięku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioriza CPU e GPU no Apple Silicon, reduzindo latência de controles sem fio e AirPods."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioriza o desempenho de CPU e GPU no Apple Silicon, reduzindo a latência dos comandos e AirPods."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приоритизирует производительность CPU и GPU на Apple Silicon, снижая задержку контроллера и звука."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioriterar CPU- och GPU-prestanda på Apple Silicon, vilket minskar handkontroll- och ljudlatens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple 芯片上优先保障 CPU 和 GPU 性能，降低手柄与音频延迟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple 晶片上優先保障 CPU 和 GPU 效能，降低手把與音訊延遲。"
          }
        }
      }
    },
