    "settings.icloud_sync_ios_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie auf dem iPhone in den Spieleinstellungen den Ordner 'nxnative_launcher' in iCloud Drive aus. Spielstände synchronisieren sich automatisch im Hintergrund über save.dmsync!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPhone, select the 'nxnative_launcher' folder in iCloud Drive in the game settings. Saves sync automatically in background via save.dmsync!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el iPhone, selecciona la carpeta 'nxnative_launcher' en iCloud Drive dentro de las opciones del juego. ¡Las partidas se sincronizan automáticamente en segundo plano mediante save.dmsync!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur iPhone, sélectionnez le dossier 'nxnative_launcher' dans iCloud Drive dans les options du jeu. Les sauvegardes se synchronisent automatiquement en arrière-plan via save.dmsync !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su iPhone, seleziona la cartella 'nxnative_launcher' in iCloud Drive nelle opzioni di gioco. I salvataggi si sincronizzano automaticamente in background tramite save.dmsync!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneのゲーム設定で iCloud Drive 内の「nxnative_launcher」フォルダを選択してください。save.dmsync によりバックグラウンドで自動同期されます！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone의 게임 설정에서 iCloud Drive의 'nxnative_launcher' 폴더를 선택하세요. save.dmsync를 통해 백그라운드에서 자동으로 동기화됩니다!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na iPhonie wybierz folder 'nxnative_launcher' w iCloud Drive w opcjach gry. Zapisy synchronizują się automatycznie w tle przez save.dmsync!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No iPhone, selecione a pasta 'nxnative_launcher' no iCloud Drive nas opções do jogo. Os saves sincronizam automaticamente em segundo plano via save.dmsync!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "No iPhone, selecione a pasta 'nxnative_launcher' no iCloud Drive nas opções do jogo. Os saves sincronizam automaticamente em segundo plano através de save.dmsync!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На iPhone выберите папку 'nxnative_launcher' в iCloud Drive в настройках игры. Сохранения синхронизируются автоматически в фоне через save.dmsync!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj mappen 'nxnative_launcher' på iCloud Drive i spelinställningarna på din iPhone. Sparfiler synkroniseras automatiskt i bakgrunden via save.dmsync!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上的游戏设置中选择 iCloud 云盘里的“nxnative_launcher”文件夹。存档将通过 save.dmsync 在后台自动同步！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上的遊戲設定中選擇 iCloud 雲端硬碟裡的「nxnative_launcher」資料夾。存檔將透過 save.dmsync 在背景自動同步！"
          }
        }
      }
    },
