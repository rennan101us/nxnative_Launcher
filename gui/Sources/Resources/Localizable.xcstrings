    "controls.status_connected_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Controller-Navigation aktiv auf allen Tabs, Karussell und Deck."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live controller navigation active across all launcher tabs, carousel and deck."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegación con mando activa en todas las pestañas, carrusel y deck del launcher."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
