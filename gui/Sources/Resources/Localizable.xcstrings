    "presets.save_sheet_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie einen Namen für Ihr Profil ein. Es wird sicher als verschlüsselte .nxn-Datei gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a name for your custom profile. It will be securely stored as an encrypted .nxn preset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduzca un nombre para su perfil. Se guardará de forma segura en formato cifrado .nxn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nom pour votre profil. Il sera stocké en toute sécurité au format chiffré .nxn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un nome per il profilo. Verrà salvato in modo sicuro in formato crittografato .nxn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイル名を入力してください。暗号化された .nxn 形式で安全に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필 이름을 입력하세요. 암호화된 .nxn 형식으로 안전하게 저장됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź nazwę profilu. Zostanie bezpiecznie zapisany w zaszyfrowanym formacie .nxn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um nome para o seu perfil. Ele será armazenado no formato criptografado .nxn."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza um nome para o seu perfil. Ficará guardado no formato encriptado .nxn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите имя профиля. Он будет надежно сохранен в зашифрованном формате .nxn."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange ett namn för din profil. Den sparas säkert som en krypterad .nxn-fil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入配置文件名称，它将以加密的 .nxn 格式安全保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入設定檔名稱，將以加密的 .nxn 格式安全儲存。"
          }
        }
      }
    },
