    "settings_modal.oot_gfx_scale_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuert die interne Framebuffer-Skalierung: Nativ 100% verhindert Artefakte; 0.8x / 0.67x reduziert RAM-Bedarf auf Macs mit <= 12 GB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls engine framebuffer scale: Native 100% prevents upscaling artifacts; 0.8x / 0.67x cuts RAM usage on <= 12 GB Macs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla la escala del búfer de fotogramas interno: 100% nativa evita artefactos; 0.8x / 0.67x reduce el consumo de RAM en Macs de <= 12 GB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle l'échelle interne du moteur graphique : Natif 100% évite les artefacts ; 0.8x / 0.67x réduit la mémoire sur les Mac <= 12 Go."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la scala interna del framebuffer: Nativo 100% previene artefatti; 0.8x / 0.67x riduce l'uso di RAM su Mac <= 12 GB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジン内部のフレームバッファ解像度を制御します: ネイティブ100%はアーティファクトを防ぎ、0.8x / 0.67x は12GB以下のMacでメモリを大幅に節約します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엔진 내부 프레임버퍼 비율 제어: 네이티브 100%는 왜곡 방지, 0.8x / 0.67x는 12GB 이하 Mac에서 메모리를 대폭 절약합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Steruje wewnętrzną rozdzielczością bufora: Natywna 100% zapobiega artefaktom; 0.8x / 0.67x zmniejsza zużycie pamięci RAM na komputerach Mac <= 12 GB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla a escala interna do motor gráfico: Nativa 100% evita upscaling; 0.8x / 0.67x reduz uso de RAM em Macs <= 12 GB."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla a escala interna do motor gráfico: Nativa 100% evita artefactos; 0.8x / 0.67x reduz o uso de RAM em Macs <= 12 GB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляет внутренним разрешением рендера: Нативное 100% исключает артефакты; 0.8x / 0.67x снижает потребление ОЗУ на Mac с <= 12 ГБ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr intern bildrutebuffertskala: Nativ 100% förhindrar artefakter; 0.8x / 0.67x minskar RAM-användning på Macar med <= 12 GB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制游戏内部渲染帧缓冲比例：原生 100% 可防止画面瑕疵；0.8x / 0.67x 可显著降低 <= 12 GB 内存 Mac 的压力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制遊戲內部渲染緩衝區比例：原生 100% 可防止破圖瑕疵；0.8x / 0.67x 可顯著減輕 <= 12 GB 記憶體 Mac 的負擔。"
          }
        }
      }
    },
