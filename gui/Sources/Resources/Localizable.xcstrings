    "controls.mouse_auto_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart Adaptive Mode: Automatically routes mouse input to Native Switch 2 Mouse (Nmouse/JCMS) for Switch 2 games, and Emulated Right Stick (3D Camera) for Switch 1 games."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo Adaptativo Inteligente: Direciona automaticamente para Mouse Nativo do Switch 2 (Nmouse/JCMS) em jogos de Switch 2, e Analógico Direito Emulado (Câmera 3D) em jogos de Switch 1."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo Adaptativo Inteligente: Encaminha automaticamente para Rato Nativo da Switch 2 (Nmouse/JCMS) em jogos da Switch 2, e Analógico Direito Emulado (Câmara 3D) em jogos da Switch 1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modalità Adattiva Intelligente: Indirizza automaticamente a Mouse Nativo Switch 2 (Nmouse/JCMS) per giochi Switch 2, e Levetta Destra Emulata (Telecamera 3D) per giochi Switch 1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo Adaptativo Inteligente: Dirige automáticamente al Ratón Nativo de Switch 2 (Nmouse/JCMS) para juegos de Switch 2, y Stick Derecho Emulado (Cámara 3D) para juegos de Switch 1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelligenter adaptiver Modus: Leitet Mauseingaben bei Switch 2-Spielen automatisch an die native Switch 2-Maus weiter und emuliert bei Switch 1-Spielen den rechten Stick (3D-Kamera)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode Adaptatif Intelligent: Redirige automatiquement vers la Souris Native Switch 2 pour les jeux Switch 2, et le Stick Droit Émulé (Caméra 3D) pour les jeux Switch 1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマート適応モード：Switch 2ゲームではネイティブSwitch 2マウス（Nmouse/JCMS）に、Switch 1ゲームではエミュレートされた右スティック（3Dカメラ）にマウス入力を自動割り当てします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스마트 적응형 모드: Switch 2 게임에서는 네이티브 Switch 2 마우스(Nmouse/JCMS)로, Switch 1 게임에서는 에뮬레이트된 오른쪽 스틱(3D 카메라)으로 마우스 입력을 자동 연결합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inteligentny tryb adaptacyjny: Automatycznie kieruje wejście myszy do natywnej myszy Switch 2 (Nmouse/JCMS) w grach Switch 2 oraz do emulowanego prawego drążka (kamera 3D) w grach Switch 1."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Умный адаптивный режим: автоматически направляет ввод мыши на нативную мышь Switch 2 (Nmouse/JCMS) в играх для Switch 2 и на эмулируемый правый стик (3D-камера) в играх для Switch 1."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart adaptivt läge: Dirigerar automatiskt musinmatning till inbyggd Switch 2-mus (Nmouse/JCMS) för Switch 2-spel och emulerad höger styrspak (3D-kamera) för Switch 1-spel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能自适应模式：在 Switch 2 游戏中自动将鼠标输入路由至原生 Switch 2 鼠标（Nmouse/JCMS），在 Switch 1 游戏中自动路由至模拟右摇杆（3D 视角）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "智慧自適應模式：在 Switch 2 遊戲中自動將滑鼠輸入路由至原生 Switch 2 滑鼠（Nmouse/JCMS），在 Switch 1 遊戲中自動路由至模擬右類比搖桿（3D 視角）。"
          }
        }
      }
    },
