    "settings_modal.metalfx_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt spatiales Neural-Upscaling von Apple Silicon für gestochen scharfe Bildqualität."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses Apple Silicon spatial neural upscaling for crisp high-resolution presentation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa escalado neuronal espacial de Apple Silicon para una presentación nítida en alta resolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise l'upscaling neuronal d'Apple Silicon pour un rendu net en haute résolution."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa l'upscaling neurale di Apple Silicon per un'immagine nitida ad alta risoluzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Silicon の空間ニューラルアップスケーリングにより高解像度で鮮明に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선명한 고해상도 그래픽을 위해 Apple Silicon 공간 신경망 업스케일링을 사용합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używa przestrzennego skalowania Apple Silicon dla krystalicznie czystego obrazu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa upscaling neural espacial do Apple Silicon para alta resolução nítida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa upscaling neural espacial do Apple Silicon para alta resolução nítida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует нейронный апскейлинг Apple Silicon для четкого изображения высокого разрешения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använder rumslig neural uppskalning i Apple Silicon för skarp högupplöst visning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "利用 Apple 芯片空间神经网络超分辨率技术呈现细腻清晰的高清画质。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "利用 Apple 晶片空間類神經網路超解析度技術呈現細膩清晰的高畫質。"
          }
        }
      }
    },
