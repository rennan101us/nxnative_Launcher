    "controls.rumble_floor_boost_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstärkt feine Switch-Haptik (Zelda TotK/BotW), um rotierende ERM-Motoren anzutreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevates subtle Switch game haptics (Zelda TotK/BotW) to kickstart rotating ERM motors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleva vibraciones sutiles de Switch (Zelda TotK/BotW) para activar motores rotativos ERM."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplifie les vibrations subtiles de Switch (Zelda TotK/BotW) pour lancer les moteurs ERM."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta le vibrazioni sottili di Switch (Zelda TotK/BotW) per avviare i motori ERM."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch の繊細な振動（ゼルダTotK/BotWなど）を底上げし、回転式ERMモーターを駆動させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch의 미세한 진동(젤다 왕눈/야숨)을 증폭하여 회전식 ERM 모터를 구동합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wzmacnia subtelne wibracje (Zelda TotK/BotW), aby napędzić silniki obrotowe ERM."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleva vibrações sutis do Switch (Zelda TotK/BotW) para ativar motores rotativos ERM."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleva vibrações subtis da Switch (Zelda TotK/BotW) para ativar motores rotativos ERM."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Усиливает тонкую вибрацию (Zelda TotK/BotW), чтобы запустить роторные моторы ERM."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyfter subtil Switch-haptik (Zelda TotK/BotW) för att aktivera roterande ERM-motorer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提升微弱的 Switch 震动信号（如塞尔达王国之泪/旷野之息），驱动旋转式 ERM 马达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提升微弱的 Switch 震動訊號（如薩爾達王國之淚/曠野之息），以啟動旋轉式 ERM 馬達。"
          }
        }
      }
    },
