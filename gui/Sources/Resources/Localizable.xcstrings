    "build.platform_ios_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt ein Paket zur Installation auf Ihrem iOS-Gerät via AirDrop, AltStore oder TrollStore."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a package ready to install on your mobile device via AirDrop, AltStore, or TrollStore."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea el paquete listo para instalar en tu dispositivo mediante AirDrop, AltStore o TrollStore."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée le paquet prêt à installer sur votre appareil via AirDrop, AltStore ou TrollStore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea il pacchetto pronto per l'installazione su iOS tramite AirDrop, AltStore o TrollStore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop、AltStore、TrollStore経由でインストール可能なパッケージを作成。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop, AltStore 또는 TrollStore를 통해 모바일 기기에 바로 설치할 수 있는 패키지 생성."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tworzy pakiet gotowy do instalacji na iOS przez AirDrop, AltStore lub TrollStore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria o pacote pronto para instalar no seu aparelho via AirDrop, AltStore ou TrollStore."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria o pacote pronto para instalar no seu aparelho via AirDrop, AltStore ou TrollStore."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создает пакет, готовый к установке на iOS через AirDrop, AltStore или TrollStore."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapar paket redo för installation på din enhet via AirDrop, AltStore eller TrollStore."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建安装包，可通过 AirDrop、AltStore 或 TrollStore 安装到移动设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
