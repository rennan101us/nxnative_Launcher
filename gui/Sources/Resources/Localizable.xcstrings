        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled by default so builds work seamlessly on newer Xcode releases (e.g. Xcode 27.2+) whose Metal compiler differs from dmsh_chain.lock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado por defecto para compilar sin problemas en versiones recientes de Xcode (p. ej., Xcode 27.2+) cuyo compilador Metal difiere de dmsh_chain.lock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé par défaut pour compiler sans erreur sur les versions récentes de Xcode (ex. Xcode 27.2+) dont le compilateur Metal diffère de dmsh_chain.lock."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivo per impostazione predefinita per compilare senza errori con le versioni recenti di Xcode (es. Xcode 27.2+) il cui compilatore Metal differisce da dmsh_chain.lock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトで有効。Xcode更新（Xcode 27.2以降など）でMetalコンパイラがdmsh_chain.lockと異なる場合でもエラーなくビルドできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값으로 활성화되어 최신 Xcode(예: Xcode 27.2+)의 Metal 컴파일러가 dmsh_chain.lock과 달라도 오류 없이 빌드됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie włączone, aby kompilacja działała bezbłędnie na nowszych wersjach Xcode (np. Xcode 27.2+) z innym kompilatorem niż w dmsh_chain.lock."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado por padrão para compilar sem erros em atualizações recentes do Xcode (ex.: Xcode 27.2+) cujo compilador Metal difere do dmsh_chain.lock."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado por predefinição para compilar sem erros em atualizações recentes do Xcode (ex.: Xcode 27.2+) cujo compilador Metal difere do dmsh_chain.lock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено по умолчанию для беспроблемной сборки на новых версиях Xcode (например, Xcode 27.2+), где компилятор Metal отличается от dmsh_chain.lock."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiverat som standard så att byggen fungerar på nyare Xcode-versioner (t.ex. Xcode 27.2+) vars Metal-kompilator skiljer sig från dmsh_chain.lock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认开启，以便在更新的 Xcode 版本（如 Xcode 27.2+）且 Metal 编译器与 dmsh_chain.lock 不同时也能正常构建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設開啟，以便在更新的 Xcode 版本（如 Xcode 27.2+）且 Metal 編譯器與 dmsh_chain.lock 不同時也能正常建置。"
          }
        }
      }
    },
