    "shader.section_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompiliert NVN-Shader-Pipelines vorab in lokale Metal 4-Archive für ruckelfreie 60 FPS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Precompiles NVN shader pipeline bases into local Metal 4 archives to guarantee stutter-free 60 FPS gameplay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precompila las bases de shaders NVN en archivos Metal 4 locales para garantizar 60 FPS estables sin tirones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Précompile les pipelines de shaders NVN dans des archives Metal 4 locales pour garantir 60 FPS sans saccades."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Precompila le pipeline di shader NVN in archivi Metal 4 locali per garantire 60 FPS senza scatti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NVNシェーダーパイプラインをローカルのMetal 4アーカイブへ事前コンパイルし、スタッターのない滑らかな60 FPS動作を保証します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NVN 셰이더 파이프라인을 로컬 Metal 4 아카이브로 사전 컴파일하여 끊김 없는 부드러운 60 FPS 플레이를 보장합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstępnie kompiluje shadery NVN do lokalnych archiwów Metal 4, zapewniając płynną rozgrywkę w 60 FPS bez zacięć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-compila as bases de shader NVN em arquivos Metal 4 locais para garantir 60 FPS cravados sem travamentos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-compila as bases de shaders NVN em ficheiros Metal 4 locais para assegurar 60 FPS estáveis sem soluços."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предварительно компилирует шейдеры NVN в локальные архивы Metal 4 для плавной игры при 60 FPS без микрофризов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förkompilerar NVN-shaderpipelines till lokala Metal 4-arkiv för att garantera hackfria 60 FPS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 NVN 着色器管线预编译为本地 Metal 4 归档，消除游戏卡顿并确保流畅 60 FPS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 NVN 著色器管線預先編譯為本機 Metal 4 保存庫，消除畫面卡頓並確保順暢 60 FPS。"
          }
        }
      }
    },
