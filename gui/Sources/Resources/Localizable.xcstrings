        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランチャーの全タブ、カルーセル、デッキでコントローラー操作が有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행기의 모든 탭, 회전목마 및 덱에서 컨트롤러 탐색이 활성화되어 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sterowanie kontrolerem jest aktywne na wszystkich kartach, karuzeli i decku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegação por controle ativa em todas as abas, carrossel e deck do launcher."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegação por controle ativa em todas as abas, carrossel e deck do launcher."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управление геймпадом активно на всех вкладках, карусели и деке лаунчера."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigering med handkontroll är aktiv i Launchers alla flikar, karuseller och kort."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手柄导航已激活，可在启动器的所有标签页、旋转木马和卡组之间平滑操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制器導覽已啟用，可在啟動器的所有分頁、展示輪播與牌組中流暢操作。"
          }
        }
      }
    },
    "controls.status_disconnected_desc": {
      "extractionState": "manual",
      "localizations": {
