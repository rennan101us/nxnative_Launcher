    "settings_modal.management_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne dieses Spiel aus der Ansicht oder verschiebe seine Dateien in den macOS-Papierkorb."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this game from the launcher view or move its files to macOS Trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita este juego de la vista del launcher o mueve sus archivos a la papelera de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez ce jeu de la vue du lanceur ou déplacez ses fichiers vers la corbeille macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi questo gioco dalla vista del launcher o sposta i suoi file nel cestino di macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゲームをランチャーの表示から削除するか、ファイルをゴミ箱に移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게임을 런처에서 숨기거나 파일을 macOS 휴지통으로 이동합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń tę grę z widoku lub przenieś jej pliki do kosza macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova este jogo da biblioteca ou envie seus arquivos para a Lixeira do macOS."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova este jogo da biblioteca ou envie teus ficheiros para a Reciclagem do macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скройте эту игру из лаунчера или переместите её файлы в корзину macOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dölj det här spelet från startprogrammet eller flytta dess filer till papperskorgen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从启动器视图隐藏该游戏或将其文件移至 macOS 废纸篓。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從啟動器檢視隱藏該遊戲或將其檔案移至 macOS 垃圾桶。"
          }
        }
      }
    },
