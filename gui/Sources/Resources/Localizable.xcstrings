    "settings_modal.metal_hud_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Apples offizielles Leistungs-Overlay mit Echtzeit-FPS und GPU-Metriken an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays Apple's official in-game performance overlay with real-time FPS and GPU metrics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la superposición oficial de Apple con métricas de FPS y GPU en tiempo real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche la superposition officielle d'Apple avec les FPS et les métriques GPU en temps réel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra l'overlay ufficiale delle prestazioni di Apple con FPS e metriche GPU in tempo reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple公式のパフォーマンスオーバーレイを表示し、リアルタイムのFPSとGPUメトリクスを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 FPS 및 GPU 지표가 포함된 Apple 공식 게임 내 성능 오버레이를 표시합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetla oficjalną nakładkę wydajności Apple ze wskaźnikami FPS i GPU w czasie rzeczywistym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibe o overlay oficial de desempenho da Apple com FPS e métricas de GPU em tempo real."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibe o overlay oficial de desempenho da Apple com FPS e métricas de GPU em tempo real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображает официальный игровой оверлей Apple с показателями FPS и GPU в реальном времени."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar Apples officiella prestandaöverlägg i spelet med FPS- och GPU-mått i realtid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示 Apple 官方游戏内性能悬浮窗，包含实时帧率与 GPU 负荷指标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示 Apple 官方遊戲內效能懸浮視窗，包含即時 FPS 與 GPU 負載指標。"
          }
        }
      }
    },
