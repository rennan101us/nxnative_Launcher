    "settings_modal.oot_motion_blur_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviert die Kamera-Bewegungsunschärfe (aglMotionBlur) bei Kameraschwenks für ein schärferes Bild und geringere GPU-Last."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disables the camera motion blur pass (aglMotionBlur) during camera rotation for sharper visuals and lower GPU cost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva el pase de desenfoque de movimiento de cámara (aglMotionBlur) al girar la cámara para una imagen más nítida y menor uso de GPU."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive la passe de flou de mouvement de caméra (aglMotionBlur) lors des rotations pour une image plus nette et moins de charge GPU."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva il pass di motion blur della telecamera (aglMotionBlur) durante la rotazione per immagini più nitide e minor carico GPU."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ回転時のモーションブラー（aglMotionBlur）を無効化し、より鮮明な映像とGPU負荷軽減を実現します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 회전 시 모션 블러 패스(aglMotionBlur)를 비활성화하여 더 선명한 화면과 낮은 GPU 부하를 제공합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącza efekt rozmycia ruchu kamery (aglMotionBlur) podczas obrotu, zapewniając ostrzejszy obraz i niższe obciążenie GPU."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativa o passe de motion blur na movimentação da câmera (aglMotionBlur) para imagem mais nítida e menor custo de GPU."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativa o passe de motion blur na movimentação da câmara (aglMotionBlur) para imagem mais nítida e menor custo de GPU."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключает проход размытия движения камеры (aglMotionBlur) при вращении для более чёткого изображения и снижения нагрузки на GPU."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaktiverar kamerans rörelseoskärpa (aglMotionBlur) vid kamerarörelse för skarpare bild och lägre GPU-belastning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用旋转视角时的相机动态模糊通道（aglMotionBlur），获得更清晰的画面并降低 GPU 开销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停用旋轉視角時的相機動態模糊通道（aglMotionBlur），獲得更清晰的畫面並降低 GPU 開銷。"
          }
        }
      }
    },
