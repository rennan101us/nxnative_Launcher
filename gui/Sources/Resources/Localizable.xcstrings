          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte ou emparelhe qualquer controle de Switch, Xbox, PlayStation ou 8BitDo via Bluetooth ou USB."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte ou emparelhe qualquer controle de Switch, Xbox, PlayStation ou 8BitDo via Bluetooth ou USB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите геймпад Switch, Xbox, PlayStation или 8BitDo по Bluetooth или USB."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
