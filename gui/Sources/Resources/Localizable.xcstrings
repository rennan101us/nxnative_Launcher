    "controls.mouse_switch2_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct 1:1 hardware pointer and optical sensor input via Switch 2 Nmouse / JCMS APIs. Switch 2 games with mouse support receive true native mouse input without stick emulation latency."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrada direta 1:1 de ponteiro e sensor óptico via APIs Nmouse / JCMS do Switch 2. Jogos do Switch 2 com suporte a mouse recebem entrada nativa real sem latência de emulação de stick."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrada direta 1:1 de ponteiro e sensor ótico via APIs Nmouse / JCMS da Switch 2. Jogos da Switch 2 com suporte a rato recebem entrada nativa real sem latência de emulação de analógico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Input diretto 1:1 di puntatore e sensore ottico tramite API Nmouse / JCMS di Switch 2. I giochi Switch 2 con supporto mouse ricevono input nativo reale senza latenza di emulazione stick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrada directa 1:1 de puntero y sensor óptico a través de las API Nmouse / JCMS de Switch 2. Los juegos de Switch 2 con soporte de ratón reciben entrada nativa real sin latencia de emulación de stick."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkte 1:1-Hardware-Zeiger- und optische Sensoreingabe über Switch 2 Nmouse / JCMS APIs. Switch 2-Spiele mit Mausunterstützung erhalten echte native Mauseingaben ohne Stick-Emulationslatenz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrée directe 1:1 de pointeur matériel et capteur optique via les API Nmouse / JCMS de la Switch 2. Les jeux Switch 2 compatibles reçoivent une véritable entrée souris native sans latence d'émulation de stick."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch 2のNmouse / JCMS APIによる1:1ハードウェアポインターと光学センサー直接入力。マウス対応のSwitch 2ゲームは、スティックエミュレーションの遅延なしに真のネイティブマウス入力を受け取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch 2 Nmouse / JCMS API를 통한 직접적인 1:1 하드웨어 포인터 및 광학 센서 입력입니다. 마우스를 지원하는 Switch 2 게임은 스틱 에뮬레이션 지연 없이 진정한 네이티브 마우스 입력을 받습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpośredni sprzętowy wskaźnik 1:1 i wejście sensora optycznego przez API Nmouse / JCMS Switch 2. Gry Switch 2 z obsługą myszy otrzymują prawdziwe natywne wejście myszy bez opóźnień emulacji drążka."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямой аппаратный ввод указателя 1:1 и оптического сенсора через API Nmouse / JCMS для Switch 2. Игры Switch 2 с поддержкой мыши получают полноценный нативный ввод без задержки эмуляции стика."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt 1:1-hårdvarupekare och optisk sensorinmatning via Switch 2 Nmouse / JCMS API. Switch 2-spel med musstöd får äkta inbyggd musinmatning utan fördröjning från spakemulering."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Switch 2 Nmouse / JCMS API 实现 1:1 硬件指针与光学传感器直连输入。支持鼠标的 Switch 2 游戏可获得无摇杆模拟延迟的真正原生鼠标体验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 Switch 2 Nmouse / JCMS API 實現 1:1 硬體指標與光學感測器直連輸入。支援滑鼠的 Switch 2 遊戲可獲得無搖桿模擬延遲的真正原生滑鼠體驗。"
          }
        }
      }
    },
