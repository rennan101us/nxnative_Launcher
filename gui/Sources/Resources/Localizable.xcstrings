    "build.opt_romfs_separate_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt große Spieldateien außerhalb des IPAs. Erzeugt ein leichtes IPA (<100 MB) für AltStore, Sideloadly oder Kravasign."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaves large game files out of the IPA. Generates a lightweight (<100 MB) IPA for AltStore, Sideloadly, or Kravasign, keeping RomFS.img for one-time direct transfer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja los archivos grandes del juego fuera del IPA. Genera un IPA ligero (<100 MB) para AltStore, Sideloadly o Kravasign, guardando RomFS.img para una transferencia directa única."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse les fichiers volumineux hors de l'IPA. Génère un IPA léger (<100 Mo) pour AltStore, Sideloadly ou Kravasign, en conservant RomFS.img pour un transfert direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia i file di grandi dimensioni fuori dall'IPA. Genera un IPA leggero (<100 MB) per AltStore, Sideloadly o Kravasign."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大容量ゲームファイルを IPA の外部に残します。AltStore や Sideloadly 向けに軽量な IPA (<100 MB) を生成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대용량 게임 파일을 IPA 외부에 보관합니다. AltStore, Sideloadly용 경량(<100MB) IPA를 생성합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostawia duże pliki poza IPA. Generuje lekki plik IPA (<100 MB) dla AltStore lub Sideloadly."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém os arquivos pesados fora do IPA. Gera um IPA leve (<100 MB) ideal para AltStore, Sideloadly ou Kravasign, transferindo o RomFS.img uma única vez."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém os ficheiros pesados fora do IPA. Gera um IPA leve (<100 MB) ideal para AltStore, Sideloadly ou Kravasign, transferindo o RomFS.img uma única vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставляет крупные файлы вне IPA. Создает облегченный IPA (<100 МБ) для AltStore или Sideloadly."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämnar stora spelfiler utanför IPA-filen. Skapar en lätt IPA (<100 MB) för AltStore eller Sideloadly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将大型游戏文件保留在 IPA 外部。为 AltStore、Sideloadly 或 Kravasign 生成轻量级 (<100 MB) IPA。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將大型遊戲檔案保留在 IPA 外部。為 AltStore、Sideloadly 或 Kravasign 產生輕量級 (<100 MB) IPA。"
          }
        }
      }
    },
