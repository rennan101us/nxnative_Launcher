    "settings_modal.oot_mic_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt Pusten oder Sprechen über das Mac-Mikrofon für Spielmechaniken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows playing the Ocarina with breath using the macOS microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite soplar o hablar usando el micrófono del Mac para mecánicas interactivas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet de souffler ou parler via le micro du Mac pour les mécaniques de jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permette di soffiare o parlare usando il microfono del Mac per le meccaniche di gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac のマイクから息を吹きかけたり話しかけたりしてゲームギミックを操作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 마이크로 바람을 불거나 말하여 게임 내 기믹을 조작합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umożliwia dmuchanie lub mówienie przez mikrofon Maca w mechanikach gry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite tocar a Ocarina com sopros usando o microfone do macOS."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite tocar a Ocarina com sopros utilizando o microfone do macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет дуть или говорить в микрофон Mac для игровых механик."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåter att blåsa eller tala genom Macens mikrofon för spelmekaniker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许通过 Mac 麦克风吹气或说话以触发游戏机制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許透過 Mac 麥克風吹氣或說話以觸發遊戲機制。"
          }
        }
      }
    },
