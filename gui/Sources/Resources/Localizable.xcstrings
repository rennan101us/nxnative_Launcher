    "port_modal.switch2_ios_experimental_notice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Portieren von Switch 2 auf iOS ist experimentell. Es wird ein unsigniertes .ipa-Paket erzeugt, das ein A17 Pro+ oder A18 Pro Gerät (8 GB RAM) erfordert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch 2 porting for iOS is experimental. Compiling produces an unsigned .ipa package requiring an A17 Pro+ or A18 Pro device (8GB RAM)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El porte de Switch 2 para iOS es experimental. La compilación genera un paquete .ipa no firmado que requiere un dispositivo con chip A17 Pro+ o A18 Pro (8GB de RAM)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le portage Switch 2 vers iOS est expérimental. La compilation produit un paquet .ipa non signé nécessitant un appareil avec puce A17 Pro+ ou A18 Pro (8 Go de RAM)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il porting di Switch 2 su iOS è sperimentale. La compilazione produce un pacchetto .ipa non firmato che richiede un dispositivo A17 Pro+ o A18 Pro (8 GB di RAM)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch 2 の iOS への移植は実験的機能です。A17 Pro+ または A18 Pro（RAM 8GB）を搭載したデバイスが必要な未署名の .ipa パッケージを生成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch 2의 iOS 포팅은 실험적 기능입니다. A17 Pro+ 또는 A18 Pro(8GB RAM) 기기가 필요한 서명되지 않은 .ipa 패키지가 생성됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portowanie gier Switch 2 na iOS jest eksperymentalne. Kompilacja tworzy niepodpisany pakiet .ipa wymagający urządzenia z procesorem A17 Pro+ lub A18 Pro (8 GB RAM)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O porte de Switch 2 para iOS é experimental. A compilação gera um pacote .ipa não assinado que requer um aparelho com chip A17 Pro+ ou A18 Pro (8GB de RAM)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O porte de Switch 2 para iOS é experimental. A compilação gera um pacote .ipa não assinado que requer um dispositivo com chip A17 Pro+ ou A18 Pro (8GB de RAM)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Портирование Switch 2 на iOS является экспериментальным. При компиляции создается неподписанный пакет .ipa, для которого требуется устройство с чипом A17 Pro+ или A18 Pro (8 ГБ ОЗУ)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Portning av Switch 2 till iOS är experimentell. Kompileringen skapar ett osignerat .ipa-paket som kräver en enhet med A17 Pro+ eller A18 Pro (8 GB RAM)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch 2 移植至 iOS 属于实验性功能。编译将生成未签名的 .ipa 安装包，需要配备 A17 Pro+ 或 A18 Pro 芯片（8GB 内存）的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch 2 移植至 iOS 屬於實驗性功能。編譯將生成未簽名的 .ipa 安裝套件，需要配備 A17 Pro+ 或 A18 Pro 晶片（8GB 記憶體）的裝置。"
          }
        }
      }
    },
