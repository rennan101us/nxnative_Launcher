          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建 Android arm64 二进制文件所需的 Clang 交叉编译器与原生库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "構建 Android arm64 二進位檔案所需的 Clang 交叉編譯器與原生庫。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompilator skrośny Clang i natywne biblioteki wymagane dla plików binarnych arm64 Androida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кросс-компилятор Clang и нативные библиотеки для бинарных файлов arm64 Android."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Clang-korskompilator och inbyggda bibliotek för Android arm64-binärer."
          }
        }
      }
    },
