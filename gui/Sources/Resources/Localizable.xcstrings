    "onboarding.clt_prompt_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte bestätige das Apple-Installationsfenster für die Command Line Tools."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm the Apple Command Line Tools installer window that appeared on your screen. Setup will resume automatically as soon as it finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma la ventana de instalación de Apple Command Line Tools. El proceso continuará automáticamente al finalizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Validez la fenêtre d'installation Apple Command Line Tools. La progression reprendra automatiquement ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma la finestra Apple Command Line Tools comparsa sullo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面に表示された Apple Command Line Tools のインストールを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에 표시된 Apple Command Line Tools 설치 창을 승인해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdź okno instalatora Apple Command Line Tools."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme a janela oficial da Apple para instalar o Command Line Tools. A barra continuará automaticamente assim que concluir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme a janela da Apple para instalar as Command Line Tools. A instalação continuará automaticamente ao terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите окно установки Apple Command Line Tools на экране."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekräfta Apple Command Line Tools-fönstret som visas på skärmen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在屏幕上弹出的 Apple Command Line Tools 安装窗口中点击确认，完成后将自动继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在螢幕上彈出的 Apple Command Line Tools 安裝視窗中確認，完成後將自動繼續。"
          }
        }
      }
    },
