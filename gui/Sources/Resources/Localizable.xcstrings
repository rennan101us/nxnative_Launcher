    "build.disk_space_low_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aktuelle Ziel hat nicht genügend freien Speicherplatz. Wählen Sie einen anderen Ordner oder ein anderes Laufwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current destination has insufficient free space. Choose another folder or drive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El destino actual no tiene suficiente espacio libre. Elige otra carpeta o unidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'emplacement actuel ne dispose pas de suffisamment d'espace libre. Choisissez un autre dossier ou disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La destinazione attuale non dispone di spazio sufficiente. Scegli un'altra cartella o unità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の保存先に十分な空き容量がありません。別のフォルダまたはドライブを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 대상 위치에 여유 공간이 부족합니다. 다른 폴더나 드라이브를 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bieżąca lokalizacja docelowa nie ma wystarczającej ilości wolnego miejsca. Wybierz inny folder lub dysk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O local atual não tem espaço livre suficiente. Escolha outra pasta ou unidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O local atual não tem espaço livre suficiente. Escolha outra pasta ou unidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В текущем месте назначения недостаточно свободного места. Выберите другую папку или диск."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den aktuella platsen har inte tillräckligt med ledigt utrymme. Välj en annan mapp eller enhet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前目标位置没有足够的可用空间。请选择其他文件夹或驱动器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前的目標位置沒有足夠的可用空間。請選擇其他資料夾或磁碟機。"
          }
        }
      }
    },
    "build.disk_space_short_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert ~%@, aber Zielort hat nur %@ frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs ~%@, but destination only has %@ available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere ~%@, pero el destino solo tiene %@ disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
