    "shader.interrupted_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel wurde vor Abschluss der Shader-Kompilierung beendet (%d von %d fertig). Soll der Launcher die Optimierung im Hintergrund fortsetzen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game was closed before completing shader compilation (%d of %d completed). Would you like the Launcher to finish compiling shaders in background now?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego se cerró antes de completar la compilación (%d de %d completados). ¿Desea que el Launcher termine la optimización en segundo plano ahora?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu a été fermé avant la fin de la compilation (%d sur %d terminés). Souhaitez-vous que le Launcher termine l'optimisation en arrière-plan ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gioco è stato chiuso prima del completamento della compilazione (%d di %d completati). Vuoi che il Launcher completi l'ottimizzazione in background?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパイル完了前にゲームが終了しました (%d / %d 完了)。バックグラウンドで最適化を完了させますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴파일 완료 전 게임이 종료되었습니다 (%d / %d 완료). 런처가 백그라운드에서 최적화를 완료하도록 하시겠습니까?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gra została zamknięta przed ukończeniem kompilacji (%d z %d gotowych). Czy Launcher ma dokończyć optymalizację w tle?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jogo foi fechado antes de concluir a compilação de shaders (%d de %d concluídos). Deseja que o Launcher finalize a otimização em segundo plano agora?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O jogo foi fechado antes de concluir a compilação (%d de %d concluídos). Pretende que o Launcher conclua a otimização em segundo plano agora?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игра была закрыта до завершения компиляции (%d из %d готово). Завершить оптимизацию в фоновом режиме сейчас?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelet stängdes innan kompileringen slutfördes (%d av %d klara). Vill du slutföra optimeringen i bakgrunden nu?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏在着色器编译完成前已退出（已完成 %d / %d）。是否让启动器在后台继续完成优化？"
          }
        },
        "zh-Hant": {
