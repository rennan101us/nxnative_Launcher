    "library.trash_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies verschiebt die kompilierte Spieldatei sicher in den macOS-Papierkorb."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will safely move the compiled game file to your macOS Trash. You can restore it from Trash if needed, or empty Trash to free up storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto moverá de forma segura el archivo del juego a la papelera de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela déplacera le fichier du jeu dans la corbeille de macOS en toute sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo sposterà in sicurezza il file compilato del gioco nel cestino di macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルド済みゲームファイルをmacOSのゴミ箱に移動します。必要に応じてゴミ箱から戻すことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴파일된 게임 파일을 macOS 휴지통으로 안전하게 이동합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to bezpieczne przeniesienie gry do kosza macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação moverá com segurança o arquivo do jogo para a Lixeira do macOS. Você poderá recuperá-lo da Lixeira se necessário ou esvaziá-la para liberar espaço."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação moverá com segurança o ficheiro do jogo para a Reciclagem do macOS. Tu poderá recuperá-lo da Reciclagem se necessário ou esvaziá-la para liberar espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скомпилированная игра будет безопасно перемещена в корзину macOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta flyttar säkert det kompilerade spelet till macOS papperskorg."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作会将已编译的游戏文件安全移动到 macOS 废纸篓中。如果需要，您可以从废纸篓放回原处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將安全地將編譯後的遊戲檔案移至 macOS 垃圾桶。"
          }
        }
      }
    },
