    "settings_modal.gamepad_profile_desc_off": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitet 1:1 Signale weiter, um Konflikte mit internen Tastenbelegungen zu vermeiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passes raw 1:1 controller signals to prevent conflicts with in-game button mapping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía comandos 1:1 directos para evitar conflictos con el mapeo del propio juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmet les signaux 1:1 directs pour éviter les conflits avec le jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia comandi 1:1 diretti per evitare conflitti con i comandi del gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲーム内のボタン配置との競合を防ぐため、1:1の生信号を送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 내 버튼 매핑과의 충돌을 방지하기 위해 1:1 신호를 그대로 전달합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyła bezpośrednie sygnały 1:1, zapobiegając konfliktom ze sterowaniem w grze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia comandos 1:1 diretos para evitar conflitos com o remapeamento próprio do jogo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia comandos 1:1 diretos para evitar conflitos com o remapeamento próprio do jogo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передает сигналы 1:1 без изменений во избежание конфликтов с игрой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skickar direkta 1:1 signaler för att förhindra konflikter med spelets kontroller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传递原始 1:1 手柄信号，以防止与游戏内按键映射发生冲突。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳遞原始 1:1 控制器訊號，以避免與遊戲內對應衝突。"
          }
        }
      }
    },
