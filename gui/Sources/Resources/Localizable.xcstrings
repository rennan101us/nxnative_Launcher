    "settings_modal.oot_desc_ultraboost": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umgeht den Switch 2 Neural Upscaler. Spart GPU-Zeit und wendet Hardware-AMD-CAS via Metal an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bypasses Switch 2 neural upscaler. Saves GPU frame-time and applies hardware AMD CAS via Metal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omite el escalador neural de Switch 2. Ahorra tiempo de GPU y aplica AMD CAS por hardware vía Metal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contourne l'upscaler neuronal Switch 2. Économise du GPU et applique AMD CAS matériel via Metal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bypassa l'upscaler neurale di Switch 2. Risparmia tempo GPU e applica AMD CAS hardware via Metal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch 2 のニューラルスケーラーをバイパス。GPU負荷を削減し、Metal経由でAMD CASを適用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch 2 뉴럴 업스케일러를 우회하여 GPU 시간을 절약하고 Metal을 통해 하드웨어 AMD CAS를 적용합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omija upscaler neuralny Switcha 2. Oszczędza czas GPU i stosuje sprzętowy AMD CAS przez Metal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bypass do neural upscaler Switch 2. Economiza tempo de GPU e aplica AMD CAS em hardware via Metal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Bypass do neural upscaler Switch 2. Poupa tempo de GPU e aplica AMD CAS em hardware via Metal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обходит нейроскейлер Switch 2. Экономит ресурсы GPU и применяет аппаратный AMD CAS через Metal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kringgår Switch 2 neural upscaler. Sparar GPU-tid och tillämpar hårdvaru-AMD CAS via Metal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绕过 Switch 2 神经超分辨率。节省 GPU 时间并通过 Metal 应用硬件 AMD CAS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繞過 Switch 2 神經超解析度。節省 GPU 時間並透過 Metal 套用硬體 AMD CAS。"
          }
        }
      }
    },
    "settings_modal.oot_fixed_res_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixiert den Render-Puffer auf native Auflösung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disables dynamic resolution drops, keeping graphics 100% native and crisp."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija el búfer de renderizado en resolución nativa para evitar fluctuaciones dinámicas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouille le tampon de rendu en résolution native."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fissa il buffer di rendering alla risoluzione nativa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンダリングバッファをネイティブ解像度に固定し、動的変動を抑えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌더 버퍼를 네이티브 해상도로 고정하여 동적 변동을 방지합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokuje bufor renderowania na rozdzielczości natywnej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativa quedas dinâmicas de resolução, mantendo a imagem 100% nítida e cristalina."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativa descidas dinâmicas de resolução, mantendo a imagem 100% nítida e cristalina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фиксирует буфер рендеринга на нативном разрешении."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låser renderingsbufferten vid nativ upplösning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将渲染缓冲区锁定为原生分辨率以防止动态波动。"
