    "ipa_health.select_source_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie den Ordner oder die Switch-Datei (.nsp/.xci/.nup) für %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the folder or base Switch file (.nsp/.xci/.nup) to rebuild %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la carpeta o archivo Switch base (.nsp/.xci/.nup) para reconstruir %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le dossier ou fichier Switch de base (.nsp/.xci/.nup) pour %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la cartella o il file Switch (.nsp/.xci/.nup) per %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を再構築するためのフォルダまたは Switch ファイル (.nsp/.xci/.nup) を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@를 재구축할 기본 Switch 파일(.nsp/.xci/.nup) 또는 폴더를 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder lub plik Switcha (.nsp/.xci/.nup), aby przebudować %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a pasta ou o arquivo base (.nsp/.xci/.nup) para gerar um novo .ipa de %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a pasta ou o arquivo base (.nsp/.xci/.nup) para gerar um novo .ipa de %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку или исходный файл Switch (.nsp/.xci/.nup) для %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj mappen eller Switch-filen (.nsp/.xci/.nup) för att bygga om %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择用于重新构建 %@ 的文件夹或基础 Switch 文件 (.nsp/.xci/.nup)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇用於重新建置 %@ 的資料夾或基礎 Switch 檔案 (.nsp/.xci/.nup)。"
          }
        }
      }
    },
