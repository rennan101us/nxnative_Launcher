          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все шейдерные конвейеры скомпилированы и сохранены в кэш. Игра будет работать при стабильных 60 FPS!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla shaderpipelines har kompilerats och sparats i cachen. Ditt spel körs nu i jämna 60 FPS!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
