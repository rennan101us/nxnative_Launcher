    "settings_modal.fps_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperrt den internen Bildbegrenzer auf 60 FPS mit flüssigem VSync."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlocks the game's internal frame limiter to 60 FPS with smooth VSync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea el limitador de fotogramas a 60 FPS con VSync suave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloque la limite interne à 60 FPS avec VSync fluide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca il limite interno di fotogrammi a 60 FPS con VSync fluido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲーム内部のフレームリミッターを解除し、滑らかなVSyncで60 FPSを実現します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원활한 VSync와 함께 게임의 내부 프레임 제한을 60 FPS로 해제합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokowuje wewnętrzny limit klatek do 60 FPS z płynną synchronizacją pionową (VSync)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueia o limitador interno do jogo para 60 FPS com VSync fluido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueia o limitador interno do jogo para 60 FPS com VSync fluido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокирует внутренний лимит кадров до 60 FPS с плавной вертикальной синхронизацией."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låser upp spelets interna bildfrekvensbegränsning till 60 FPS med mjuk VSync."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁游戏内部帧率上限至 60 FPS，并启用平滑垂直同步 (VSync)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖遊戲內部畫格率上限至 60 FPS，並啟用平滑垂直同步 (VSync)。"
          }
        }
      }
    },
