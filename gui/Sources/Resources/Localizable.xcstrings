    "build.platform_mac_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt auf Ihrem Mac spielen mit Controller oder Tastatur, hoher Auflösung und bis zu 60 FPS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play directly on your Mac with controller or keyboard, high resolution, and up to 60 FPS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega directamente en tu Mac con mando o teclado, alta resolución y hasta 60 FPS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouez directement sur votre Mac avec manette ou clavier, haute résolution et jusqu'à 60 FPS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gioca direttamente sul tuo Mac con controller o tastiera, alta risoluzione e fino a 60 FPS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントローラーまたはキーボードを使って、Mac上で直接高解像度・最大60 FPSでプレイ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨트롤러 또는 키보드를 연결하여 고해상도 최대 60 FPS로 Mac에서 직접 플레이."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Graj bezpośrednio na Macu przy użyciu kontrolera lub klawiatury w wysokiej rozdzielczości i do 60 FPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogue diretamente no seu Mac com controle ou teclado, alta resolução e até 60 FPS."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogue diretamente no seu Mac com controle ou teclado, alta resolução e até 60 FPS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играйте прямо на Mac с геймпадом или клавиатурой, в высоком разрешении и до 60 FPS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela direkt på din Mac med handkontroll eller tangentbord, i hög upplösning och upp till 60 FPS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接在 Mac 上连接手柄或键盘游玩，享受高分辨率与最高 60 FPS 体验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接在 Mac 上連接控制器或鍵盤遊玩，享受高解析度與最高 60 FPS 體驗。"
          }
        }
      }
    },
