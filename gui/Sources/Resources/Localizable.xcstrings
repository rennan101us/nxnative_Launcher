          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac に Ryujinx または Ryubing のインストールが見つかりませんでした。prod.keys をここに配置するか、手動でフォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 Ryujinx 또는 Ryubing 설치를 찾을 수 없습니다. 여기에 prod.keys를 넣거나 폴더를 직접 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można znaleźć instalacji Ryujinx lub Ryubing na tym komputerze Mac. Umieść tutaj swój plik prod.keys lub wybierz folder ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível localizar o Ryujinx ou Ryubing instalado neste Mac. Insira seu prod.keys ou selecione a pasta manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível localizar o Ryujinx ou Ryubing instalado neste Mac. Insira o seu prod.keys ou selecione a pasta manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось найти установленный Ryujinx или Ryubing на этом Mac. Поместите prod.keys сюда или выберите папку вручную."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte hitta någon Ryujinx- eller Ryubing-installation på denna Mac. Placera din prod.keys här eller välj mappen manuellt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
