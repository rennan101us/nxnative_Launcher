          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado en ACTIVADO: RomFS separado requiere que los archivos extraídos sigan disponibles para transferirse mediante push_romfs.sh."
          }
        },
        "fr": {
          "stringUnit": {
