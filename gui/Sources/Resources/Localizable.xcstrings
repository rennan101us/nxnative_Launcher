    "build.metal_mismatch_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Metal-Compiler dieses Macs weicht von dmsh_chain.lock ab. Aktivieren Sie --allow-other-metal, um mit Ihrer aktuellen Xcode-Version zu kompilieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac's Metal compiler differs from dmsh_chain.lock. Enable --allow-other-metal to build with your current Xcode toolchain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El compilador Metal de tu Mac difiere de dmsh_chain.lock. Activa --allow-other-metal para compilar con tu versión actual de Xcode."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compilateur Metal de votre Mac diffère de dmsh_chain.lock. Activez --allow-other-metal pour compiler avec votre version actuelle de Xcode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il compilatore Metal del tuo Mac differisce da dmsh_chain.lock. Abilita --allow-other-metal per compilare con la versione attuale di Xcode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのMetalコンパイラがdmsh_chain.lockと異なります。現在のXcodeでビルドするには--allow-other-metalを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 Metal 컴파일러가 dmsh_chain.lock과 다릅니다. 현재 Xcode로 빌드하려면 --allow-other-metal을 활성화하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompilator Metal tego Maca różni się od dmsh_chain.lock. Włącz --allow-other-metal, aby zbudować z obecną wersją Xcode."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O compilador Metal do seu Mac difere do dmsh_chain.lock. Ative --allow-other-metal para compilar com a versão atual do Xcode."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O compilador Metal do seu Mac difere do dmsh_chain.lock. Ative --allow-other-metal para compilar com a versão atual do Xcode."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компилятор Metal на этом Mac отличается от dmsh_chain.lock. Включите --allow-other-metal для сборки с текущей версией Xcode."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Macs Metal-kompilator skiljer sig från dmsh_chain.lock. Aktivera --allow-other-metal för att bygga med aktuell Xcode-version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 Mac 的 Metal 编译器与 dmsh_chain.lock 不一致。启用 --allow-other-metal 即可使用当前 Xcode 构建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前 Mac 的 Metal 編譯器與 dmsh_chain.lock 不一致。啟用 --allow-other-metal 即可使用目前 Xcode 建置。"
          }
        }
      }
    },
