    "library.hide_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel wird nicht mehr in Ihrer Bibliothek angezeigt. Die Spieldateien bleiben sicher auf dem Datenträger erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game will no longer appear in your library. Its files will remain safely on disk. You can restore hidden games anytime in Settings > System."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego ya no aparecerá en tu biblioteca. Sus archivos permanecerán en el disco. Puedes restaurar juegos ocultos en Ajustes > Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu n'apparaîtra plus dans votre bibliothèque. Ses fichiers resteront intacts sur le disque. Vous pouvez restaurer les jeux masqués dans Réglages > Système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gioco non apparirà più nella libreria. I suoi file rimarranno al sicuro sul disco. Puoi ripristinare i giochi nascosti in Impostazioni > Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームはライブラリから非表示になりますが、ファイルはディスク上に安全に保持されます。設定 > システムからいつでも再表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임이 라이브러리에 더 이상 표시되지 않습니다. 파일은 디스크에 안전하게 유지됩니다. 설정 > 시스템에서 언제든지 복원할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gra nie będzie już widoczna w bibliotece. Jej pliki pozostaną bezpieczne na dysku. Możesz przywrócić ukryte gry w Ustawienia > System."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jogo não aparecerá mais na biblioteca. Seus arquivos permanecerão intactos no disco. Você pode restaurar jogos ocultos a qualquer momento em Ajustes > Sistema."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O jogo não aparecerá mais na biblioteca. Seus ficheiros permanecerão intactos no disco. Tu pode restaurar jogos ocultos a qualquer momento em Ajustes > Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игра больше не будет отображаться в библиотеке. Её файлы останутся на диске. Вы можете восстановить скрытые игры в Настройки > Система."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelet visas inte längre i biblioteket. Dess filer ligger kvar säkert på disken. Du kan återställa dolda spel i Inställningar > System."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该游戏将不再显示在游戏库中，但文件仍完整保留在磁盘上。您可以随时在“设置 > 系统”中恢复隐藏的游戏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該遊戲將不再顯示於收藏庫中。檔案將完整保存在磁碟上。可在「設定 > 系統」中隨時還原隱藏遊戲。"
          }
        }
      }
    },
