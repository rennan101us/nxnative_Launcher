    "build.community_disclaimer_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Community-Benutzeroberfläche erleichtert die Portierung von Switch-Spielen ohne Terminal-Befehle. Hinweis: Sobald der Originalentwickler einen offiziellen Launcher veröffentlicht, wird dieses Projekt zugunsten der offiziellen Version eingestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This community GUI is a helper tool to make porting Switch games accessible without terminal commands. Notice: As soon as the upstream developer releases an official launcher, this project will be deprecated in favor of the official release."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta interfaz comunitaria es una herramienta para facilitar la portabilidad de juegos de Switch sin comandos de terminal. Aviso: Tan pronto como el desarrollador original publique un launcher oficial, este proyecto dará paso a la versión oficial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette interface communautaire facilite le portage de jeux Switch sans ligne de commande. Remarque : dès que le développeur original publiera un lanceur officiel, ce projet sera abandonné au profit de la version officielle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa interfaccia grafica della community serve a rendere accessibile il porting di giochi Switch senza terminale. Nota: Non appena lo sviluppatore a monte rilascerà un launcher ufficiale, questo progetto sarà ritirato in suo favore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコミュニティ GUI は、ターミナル操作なしで Switch ゲームの移植を行えるツールです。注意：上流の開発者が公式ランチャーをリリース次第、本プロジェクトは公式版に移行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 커뮤니티 GUI는 터미널 명령 없이 스위치 게임 이식을 쉽게 해주는 도구입니다. 주의: 원작자가 공식 런처를 출시하면 이 프로젝트는 공식 릴리스로 대체됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten interfejs społecznościowy ułatwia portowanie gier ze Switcha bez komend w terminalu. Uwaga: Gdy autor wyda oficjalny launcher, ten projekt ustąpi miejsca oficjalnej wersji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta interface da comunidade é uma ferramenta para facilitar a conversão de jogos do Switch sem comandos de terminal. Aviso: Assim que o desenvolvedor original lançar um inicializador oficial, este projeto dará lugar ao oficial."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta interface da comunidade é uma ferramenta para facilitar a conversão de jogos do Switch sem comandos de terminal. Aviso: Assim que o desenvolvedor original lançar um inicializador oficial, este projeto dará lugar ao oficial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот графический интерфейс упрощает портирование игр Switch без командной строки. Примечание: как только автор выпустит официальный лаунчер, проект уступит место официальному релизу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här grafiska gemenskapsgränssnittet gör det möjligt att porta Switch-spel utan terminalkommandon. Observera: När uppströmsutvecklaren släpper en officiell startare kommer projektet att fasas ut till förmån för den officiella utgåvan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本社区图形界面旨在让用户无需终端命令即可移植 Switch 游戏。提示：一旦上游开发者发布官方启动器，本项目将过渡至官方版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本社群圖形化介面旨在讓使用者無須終端機指令即可移植 Switch 遊戲。注意：一旦原開發者發布官方啟動器，本專案將讓位給官方版本。"
          }
        }
      }
    },
