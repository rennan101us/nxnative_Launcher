    "compatibility.mali_no_bc_textures": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No hardware Block Compression (BC) texture support. Crashes on launch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem suporte a texturas comprimidas em bloco (BC). Falha na inicialização."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem suporte a texturas comprimidas em bloco (BC). Falha na inicialização."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin soporte para texturas comprimidas en bloque (BC). Fallo al iniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de support pour les textures compressées en bloc (BC). Plante au lancement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Unterstützung für Blockkompression (BC)-Texturen. Absturz beim Start."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun supporto per texture compresse a blocchi (BC). Si blocca all'avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロック圧縮（BC）テクスチャ非対応。起動時にクラッシュします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하드웨어 블록 압축(BC) 텍스처 미지원. 실행 시 충돌 발생."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少硬件块压缩 (BC) 纹理支持，启动即崩溃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少硬體區塊壓縮 (BC) 紋理支援，啟動即崩潰。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak sprzętowej kompresji blokowej (BC) tekstur. Błąd przy uruchomieniu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсутствует поддержка текстур с блочным сжатием (BC). Сбой при запуске."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget stöd för hårdvarubaserade blockkomprimerade (BC) texturer. Kraschar vid start."
          }
        }
      }
    },
