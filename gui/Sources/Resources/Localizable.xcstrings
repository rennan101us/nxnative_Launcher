    "onboarding.deps_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Nächstes werden die benötigten Abhängigkeiten heruntergeladen, installiert und eingerichtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next, we will download, install, and configure the dependencies needed to port and run games on your Mac and iOS devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A continuación descargaremos, instalaremos y configuraremos las dependencias necesarias para portar y ejecutar juegos en Mac y iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépendances requises vont être téléchargées, installées et configurées pour porter et exécuter vos jeux sur Mac et iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno ora scaricate, installate e configurate le dipendenze necessarie per convertire ed eseguire i giochi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームの移植と実行に必要な依存関係のダウンロード、インストール、設定を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임을 포팅하고 실행하는 데 필요한 종속성을 다운로드, 설치 및 구성합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następnie pobierzemy, zainstalujemy i skonfigurujemy wymagane zależności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A seguir, faremos o download, a instalação e a configuração das dependências necessárias para portar e rodar jogos no seu Mac e dispositivos iOS."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em seguida, será efetuada a transferência, instalação e configuração das dependências necessárias para portar e executar jogos no Mac e iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Далее будут загружены, установлены и настроены необходимые зависимости."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Härnäst kommer nödvändiga beroenden att laddas ner, installeras och konfigureras."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来将下载、安装并配置在 Mac 和 iOS 设备上移植与运行游戏所需的依赖项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接下來將下載、安裝並設定在 Mac 和 iOS 裝置上移植與執行遊戲所需的相依項目。"
          }
        }
      }
    },
