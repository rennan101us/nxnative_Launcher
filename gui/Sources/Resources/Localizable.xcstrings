          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede ~%@, ma la destinazione ha solo %@ disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約 %@ 必要ですが、保存先には %@ しか空きがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 %@ 필요하지만 대상에 %@만 여유가 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymaga ~%@, ale w miejscu docelowym jest tylko %@ wolnego miejsca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer ~%@, mas o destino possui apenas %@ livre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer ~%@, mas o destino possui apenas %@ livre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется ~%@, но в месте назначения доступно только %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräver ~%@, men målet har bara %@ ledigt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 ~%@，但目标位置仅有 %@ 可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 ~%@，但目標位置僅有 %@ 可用。"
          }
        }
      }
    },
    "build.disk_space_warning_format": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicherwarnung: Die Extraktion von %@ erfordert ~%@, aber es sind nur %@ am Zielort frei. Geben Sie mindestens %@ auf diesem Volume frei oder wählen Sie ein anderes Ziel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage warning: %@ extraction requires ~%@, but only %@ is free on output destination. Please free up at least %@ on that volume or select another destination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso de almacenamiento: La extracción de %@ requiere ~%@, pero solo hay %@ libres en el destino. Libera al menos %@ en ese volumen o selecciona otro destino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avertissement d'espace: L'extraction de %@ nécessite ~%@, mais seulement %@ sont libres. Libérez au moins %@ sur ce volume ou choisissez une autre destination."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avviso archiviazione: L'estrazione di %@ richiede ~%@, ma ci sono solo %@ liberi. Libera almeno %@ o seleziona un'altra destinazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージ警告: %@ の抽出には約 %@ が必要ですが、保存先の空き容量は %@ のみです。少なくとも %@ の空きを確保するか、別の保存先を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간 경고: %@ 추출에는 약 %@가 필요하지만 대상 공간은 %@만 남아 있습니다. 최소 %@ 이상 확보하거나 다른 저장 위치를 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostrzeżenie o pamięci: Wyodrębnienie %@ wymaga ~%@, ale dostępne jest tylko %@. Zwolnij co najmniej %@ lub wybierz inne miejsce docelowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso de armazenamento: A extração de %@ requer ~%@, mas há apenas %@ livres no destino. Libere pelo menos %@ no volume ou selecione outro destino."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso de armazenamento: A extração de %@ requer ~%@, mas há apenas %@ livres no destino. Liberte pelo menos %@ no volume ou selecione outro destino."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предупреждение о памяти: Для распаковки %@ требуется ~%@, но свободно только %@. Освободите минимум %@ или выберите другое место назначения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagringsvarning: Extrahering av %@ kräver ~%@, men endast %@ är ledigt. Frigör minst %@ eller välj en annan plats."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储警告: 解压 %@ 需要约 %@，但目标位置仅剩余 %@。请在此卷上释放至少 %@ 或选择其他目标位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存空間警告: 解壓縮 %@ 需要約 %@，但目標磁區僅剩餘 %@。請釋放至少 %@ 空間或選擇其他目標位置。"
          }
        }
      }
    },
