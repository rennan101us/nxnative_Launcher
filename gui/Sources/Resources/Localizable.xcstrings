    "nxn_launcher.single_app_notice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Spiele werden in einer einzigen App mit offiziellem dunklen Symbol auf iPhone und iPad installiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All games are installed inside a single app with the official dark icon on iPhone and iPad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los juegos se instalan dentro de una sola aplicación con icono oscuro oficial en iPhone e iPad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les jeux sont installés dans une seule application avec l'icône sombre officielle sur iPhone et iPad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i giochi vengono installati in un'unica app con l'icona scura ufficiale su iPhone e iPad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのゲームは公式ダークアイコンを備えた1つのアプリ内にiPhoneおよびiPadでインストールされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 게임은 iPhone 및 iPad의 공식 다크 아이콘이 적용된 단일 앱 내에 설치됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie gry są instalowane wewnątrz jednej aplikacji z oficjalną ciemną ikoną na iPhone i iPad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os jogos são instalados dentro de um único aplicativo com ícone dark oficial no iPhone e iPad."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os jogos são instalados dentro de uma única aplicação com ícone dark oficial no iPhone e iPad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все игры устанавливаются в одно приложение с официальной темной иконкой на iPhone и iPad."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla spel installeras i en enda app med den officiella mörka ikonen på iPhone och iPad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有游戏均安装在带有官方深色图标的单个应用程序中，支持 iPhone 和 iPad。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有遊戲均安裝在帶有官方深色圖示的單個應用程式中，支援 iPhone 和 iPad。"
          }
        }
      }
    },
