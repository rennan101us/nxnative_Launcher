    "controls.mouse_switch2_lock_cursor_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captures mouse inside the game window for seamless 360° pointer navigation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura o mouse dentro da janela do jogo para navegação fluida de ponteiro em 360°."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura o rato dentro da janela do jogo para navegação fluida de ponteiro em 360°."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cattura il mouse all'interno della finestra di gioco per una navigazione a 360° senza interruzioni."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura el ratón dentro de la ventana del juego para una navegación fluida en 360°."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält die Maus im Spielfenster für nahtlose 360°-Zeigernavigation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture la souris dans la fenêtre du jeu pour une navigation fluide du pointeur à 360°."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シームレスな360°ポインター操作のためにゲームウィンドウ内でマウスを捕捉します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원활한 360° 포인터 탐색을 위해 게임 창 내부에 마우스를 가둡니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechwytuje mysz wewnątrz okna gry dla płynnej nawigacji wskaźnikiem 360°."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Захватывает мышь внутри окна игры для плавного обзора и навигации на 360°."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fångar musen inuti spelfönstret för sömlös 360° pekarnavigering."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在游戏窗口内捕获鼠标，实现流畅的 360° 指针操控。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在遊戲視窗內擷取滑鼠，實現流暢的 360° 指標操控。"
          }
        }
      }
    },
