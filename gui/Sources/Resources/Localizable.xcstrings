    "settings_modal.oot_16gb_mode_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält alle entpackten Texturpakete im einheitlichen Speicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enables file-backed guest RAM (1G chunks) when >= 12 GB temp disk is free while keeping textures safe in memory (DM_TEX_RELEASE=0)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene todos los paquetes de texturas descomprimidos en memoria unificada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve tous les packs de textures décompressés dans la mémoire unifiée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene tutti i pacchetti texture decompressi nella memoria unificata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "展開された全テクスチャをユニファイドメモリ内に常駐させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축 해제된 모든 텍스처 팩을 통합 메모리에 상주 유지합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuje wszystkie rozpakowane pakiety tekstur w zunifikowanej pamięci RAM."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa paginação em disco de RAM guest (blocos 1G) quando há >= 12 GB livres mantendo texturas seguras na memória (DM_TEX_RELEASE=0)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa paginação em disco de RAM guest (blocos 1G) quando há >= 12 GB livres mantendo texturas seguras na memória (DM_TEX_RELEASE=0)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживает все распакованные текстуры в объединенной памяти Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håller alla uppackade texturpaket i Macens enhetliga minne."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所有解压后的材质包常驻于统一内存中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將所有解壓縮後的材質包常駐於統一記憶體中。"
          }
        }
      }
    },
