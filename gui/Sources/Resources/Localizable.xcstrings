    "system.keys_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel werden aus Ryujinx erkannt oder manuell gewählt, um Switch-Dateien zu entschlüsseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys are auto-detected from Ryujinx or chosen manually and used by nxnative to decrypt Switch game files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves se detectan de Ryujinx o se eligen manualmente para descifrar los juegos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés sont détectées depuis Ryujinx ou choisies manuellement pour déchiffrer les fichiers de jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiavi vengono rilevate da Ryujinx o scelte manualmente per decrittografare i file di gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはRyujinxから自動検出または手動で選択され、Switchゲームの復号に使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 Ryujinx에서 자동 감지되거나 수동으로 선택되어 게임 파일을 복호화하는 데 사용됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucze są wykrywane z Ryujinx lub wybierane ręcznie do deszyfrowania plików gry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves são detectadas automaticamente do Ryujinx ou escolhidas manualmente para descriptografar os jogos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves são detectadas automaticamente do Ryujinx ou escolhidas manualmente para descriptografar os jogos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи определяются автоматически из Ryujinx или выбираются вручную для дешифрования игр."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nycklar identifieras automatiskt från Ryujinx eller väljs manuellt och används av nxnative för att dekryptera Switch-spelfiler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥会自动从 Ryujinx 检测或手动指定，nxnative 用其解密 Switch 游戏文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰會從 Ryujinx 自動偵測或手動選擇，用於 nxnative 解密 Switch 遊戲檔案。"
          }
        }
      }
    },
