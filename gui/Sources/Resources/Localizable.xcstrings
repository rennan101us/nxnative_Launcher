    "port_modal.android_gpu_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Vulkan porting requires Snapdragon (Adreno) or Exynos (Xclipse) GPUs. Mali / PowerVR GPUs are unsupported."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A portagem Vulkan para Android requer GPUs Snapdragon (Adreno) ou Exynos (Xclipse). GPUs Mali / PowerVR não são compatíveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A portagem Vulkan para Android requer GPUs Snapdragon (Adreno) ou Exynos (Xclipse). GPUs Mali / PowerVR não são compatíveis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La adaptación Vulkan para Android requiere GPUs Snapdragon (Adreno) o Exynos (Xclipse). Las GPUs Mali / PowerVR no son compatibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le portage Vulkan sur Android nécessite un GPU Snapdragon (Adreno) ou Exynos (Xclipse). Les GPU Mali / PowerVR ne sont pas pris en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android-Vulkan-Portierung erfordert Snapdragon (Adreno) oder Exynos (Xclipse) GPUs. Mali / PowerVR GPUs werden nicht unterstützt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il porting Vulkan su Android richiede GPU Snapdragon (Adreno) o Exynos (Xclipse). Le GPU Mali / PowerVR non sono supportate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Vulkan 移植には Snapdragon（Adreno）または Exynos（Xclipse）GPU が必要です。Mali / PowerVR GPU は非対応です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Vulkan 포팅에는 Snapdragon(Adreno) 또는 Exynos(Xclipse) GPU가 필요합니다. Mali / PowerVR GPU는 지원되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Vulkan 移植需要 Snapdragon (Adreno) 或 Exynos (Xclipse) GPU，不支持 Mali / PowerVR GPU。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Vulkan 移植需要 Snapdragon (Adreno) 或 Exynos (Xclipse) GPU，不支援 Mali / PowerVR GPU。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portowanie Android Vulkan wymaga układów GPU Snapdragon (Adreno) lub Exynos (Xclipse). Układy Mali / PowerVR nie są obsługiwane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Портирование Vulkan на Android требует GPU Snapdragon (Adreno) или Exynos (Xclipse). GPU Mali / PowerVR не поддерживаются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Vulkan-portning kräver Snapdragon (Adreno) eller Exynos (Xclipse) GPU. Mali / PowerVR stöds inte."
          }
        }
      }
    },
    "port_modal.switch2_android_unsupported_notice": {
