    "updates.changelog_oot_pacing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "60 FPS Frame-Pacing: Integrierter frame_step-Patch im internen Bildraten-Controller sorgt für flüssige 60 FPS bei normaler 1.0x-Geschwindigkeit ohne Schnellvorlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "60 FPS Frame Pacing: Integrated frame_step patch in the internal framerate controller, keeping the game at smooth 60 FPS at normal 1.0x speed without acceleration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacing de Tiempo a 60 FPS: Parche de frame_step en el controlador interno de tasa de cuadros, manteniendo el juego a velocidad normal 1.0x sin aceleración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Régulation à 60 FPS : Patch frame_step dans le contrôleur de cadence interne, maintenant le jeu à une vitesse normale de 1.0x sans accélération artificielle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacing a 60 FPS: Patch frame_step nel controller interno del framerate, mantenendo il gioco a velocità normale 1.0x senza accelerazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "60 FPS フレームペーシング：内部フレームレートコントローラーに frame_step パッチを適用し、倍速化することなく通常速度1.0xで滑らかな60 FPSを維持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "60 FPS 프레임 페이싱: 내부 프레임 레이트 컨트롤러에 frame_step 패치를 적용하여 배속 없이 정상 1.0x 속도에서 부드러운 60 FPS를 유지합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płynność klatek 60 FPS: Wbudowana łatka frame_step w kontrolerze klatek, zapewniająca płynne 60 FPS przy normalnej prędkości 1.0x bez przyspieszania rozgrywki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacing de Tempo a 60 FPS: Patch de frame_step no controlador interno de taxa de quadros, mantendo o jogo rodando a 1.0x da velocidade normal sem aceleração."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacing de Tempo a 60 FPS: Patch de frame_step no controlador interno de taxa de quadros, mantendo o jogo a correr a 1.0x da velocidade normal sem aceleração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пейсинг кадров 60 FPS: Патч frame_step во внутреннем контроллере частоты кадров удерживает плавные 60 FPS на нормальной скорости 1.0x без ускорения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "60 FPS bildrute-pacing: Integrerad frame_step-patch i den interna bildrutehanteraren, vilket håller spelet i mjuka 60 FPS vid normal 1.0x-hastighet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "60 FPS 帧节奏优化：在内部帧率控制器中集成 frame_step 补丁，在保持正常 1.0x 游戏速度（无倍速快进）下呈现丝滑的 60 FPS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "60 FPS 幀節奏最佳化：在內部幀率控制器中整合 frame_step 修補程式，在保持正常 1.0x 遊戲速度（無倍速快進）下呈現絲滑的 60 FPS。"
          }
        }
      }
    },
    "updates.changelog_oot_video": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "60 FPS Videos & Zwischensequenzen: Umgeht den rechenintensiven NDVE-KI-Upscaler (der Einbrüche auf 20 FPS verursachte) zugunsten des nativen 1080p-Players ohne Qualitätsverlust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "60 FPS Videos & Cutscenes: Bypasses the heavy NDVE neural network upscaler (which dropped framerates to 20 fps) and enables the native 1080p player with no loss in visual quality."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos y Cinemáticas a 60 FPS: Desactiva la red neuronal NDVE (que reducía la tasa a 20 fps) y activa el reproductor nativo 1080p sin pérdida de calidad visual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidéos et cinématiques à 60 FPS : Désactive l'upscaler neuronal NDVE (qui chutait à 20 fps) au profit du lecteur 1080p natif sans perte de qualité visuelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Video e filmati a 60 FPS: Bypassa l'upscaler neurale NDVE (che causava cali a 20 fps) a favore del riproduttore nativo a 1080p senza perdita di qualità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "60 FPS 動画・カットシーン：フレームレートが20 FPSに低下していた重いNDVEニューラルネットワークアップスケーラーをバイパスし、画質を損なうことなくネイティブ1080pプレーヤーで再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "60 FPS 동영상 및 컷신: 20 FPS로 떨어지던 무거운 NDVE 신경망 업스케일러를 우회하고 화질 손실 없이 네이티브 1080p 플레이어로 재생합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmy i przerywniki w 60 FPS: Pomija obciążający upscaler sieci neuronowej NDVE (powodujący spadki do 20 FPS) na rzecz natywnego odtwarzacza 1080p bez utraty jakości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos e Cutscenes a 60 FPS: Desativa a rede neural NDVE (14 dispatches/frame que causavam queda para 20 fps) e aciona o reprodutor nativo 1080p sem perda de qualidade visual."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos e Cutscenes a 60 FPS: Desativa a rede neural NDVE (14 dispatches/frame que causavam queda para 20 fps) e aciona o leitor nativo 1080p sem perda de qualidade visual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видео и катсцены в 60 FPS: Отключает тяжелый нейросетевой апскейлер NDVE (вызывавший просадки до 20 кадров/с) в пользу нативного плеера 1080p без потери качества."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "60 FPS videor och mellansekvenser: Kringgår den tunga NDVE-uppskalaren (som orsakade fall till 20 FPS) till förmån för den inbyggda 1080p-spelaren utan kvalitetsförlust."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "60 FPS 视频与过场动画：绕过导致帧率暴跌至 20 fps 的繁重 NDVE 神经网络超分辨率器，启用原生 1080p 播放器且画质毫无损失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "60 FPS 影片與過場動畫：繞過導致幀率暴跌至 20 fps 的繁重 NDVE 神經網路超解析度器，啟用原生 1080p 播放器且畫質毫無損失。"
          }
        }
      }
    },
    "updates.changelog_system_env": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelligente Umgebungsinjektion: Speichert MetalFX- und Skalierungsoptionen, ohne spielspezifische Engine-Flags zu überschreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart Environment Injection: Saves MetalFX and render scale configurations without overwriting game-specific engine flags."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inyección Inteligente de Entorno: Configuraciones de MetalFX y escala de renderizado guardadas sin sobrescribir parámetros específicos del motor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Injection d'environnement intelligente : Enregistre les réglages MetalFX et d'échelle sans écraser les paramètres moteur spécifiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniezione intelligente dell'ambiente: Salva le impostazioni MetalFX e di scala senza sovrascrivere i parametri specifici del motore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマート環境変数インジェクション：ゲーム固有のエンジンフラグを上書きすることなく、MetalFXおよびレンダースケール設定を安全に保存。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스마트 환경 인젝션: 게임별 엔진 플래그를 덮어쓰지 않고 MetalFX 및 렌더 스케일 설정을 안전하게 보존합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inteligentne wstrzykiwanie środowiska: Zapisuje konfigurację MetalFX i skali renderowania bez nadpisywania flag silnika dla konkretnych gier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Injeção Inteligente de Ambiente: Configurações de MetalFX e render scale salvas sem sobrescrever parâmetros específicos de títulos complexos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Injeção Inteligente de Ambiente: Configurações de MetalFX e render scale guardadas sem substituir parâmetros específicos de títulos complexos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Умная инъекция окружения: Сохраняет настройки MetalFX и масштабирования рендера без перезаписи специфических флагов движка."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart miljöinjektion: Sparar MetalFX och renderingsskala utan att skriva över spelspecifika motorflaggor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能环境配置注入：保存 MetalFX 及渲染缩放设置，且不会覆盖特定游戏的引擎底层标志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "智慧環境設定注入：儲存 MetalFX 及彩現縮放設定，且不會覆蓋特定遊戲的引擎底層標誌。"
          }
        }
      }
    },
