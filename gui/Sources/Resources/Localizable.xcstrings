    "settings_modal.auto_sync_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleicht Zeitstempel und synchronisiert automatisch die neueste Version zwischen Mac, iCloud und Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compares timestamps and automatically syncs the newest version between Mac, iCloud, and device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara las fechas y sincroniza automáticamente la versión más reciente entre Mac, iCloud y el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare les dates et synchronise automatiquement la version la plus récente entre Mac, iCloud et l'appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta le date e sincronizza automaticamente la versione più recente tra Mac, iCloud e dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新日時を比較し、Mac、iCloud、デバイス間で最新のセーブデータを自動同期します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타임스탬프를 비교하여 Mac, iCloud 및 기기 간에 최신 버전을 자동으로 동기화합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porównuje znaczniki czasu i automatycznie synchronizuje najnowszą wersję między Makiem, iCloud a urządzeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara as datas e sincroniza automaticamente a versão mais recente entre Mac, iCloud e dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara as datas e sincroniza automaticamente a versão mais recente entre Mac, iCloud e dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравнивает время изменения и автоматически синхронизирует новейшую версию между Mac, iCloud и устройством."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
