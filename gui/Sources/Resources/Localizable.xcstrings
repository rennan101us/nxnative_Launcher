    "settings_modal.background_auto_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "16:9 Breitbild-Hintergrund festlegen. Behebt schwarze Hintergründe. Unterstützt PNG, JPG, JPEG, WebP, SVG."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a custom widescreen 16:9 wallpaper for this game. Fixes black backgrounds. Supports PNG, JPG, JPEG, WebP, SVG."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece un fondo panorámico 16:9 para este juego. Corrige fondos negros. Compatible con PNG, JPG, JPEG, WebP, SVG."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez un fond panoramique 16:9 pour ce jeu. Corrige les fonds noirs. Prend en charge PNG, JPG, JPEG, WebP, SVG."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta uno sfondo panoramico 16:9 per questo gioco. Risolve sfondi neri. Supporta PNG, JPG, JPEG, WebP, SVG."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "16:9ワイド壁紙を設定します。黒い背景の問題を解消します。PNG、JPG、JPEG、WebP、SVGに対応。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "16:9 와이드 배경화면을 설정합니다. 검은색 배경 현상을 수정합니다. PNG, JPG, JPEG, WebP, SVG 지원."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw szerokoekranową tapetę 16:9 dla tej gry. Naprawia czarne tło. Obsługuje PNG, JPG, JPEG, WebP, SVG."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um papel de parede widescreen 16:9 para este jogo. Corrige fundos pretos. Suporta PNG, JPG, JPEG, WebP, SVG."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define um papel de parede widescreen 16:9 para este jogo. Corrige fundos pretos. Suporta PNG, JPG, JPEG, WebP, SVG."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите широкоформатные обои 16:9 для этой игры. Устраняет черный фон. Поддержка PNG, JPG, JPEG, WebP, SVG."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en 16:9 widescreen-bakgrundsbild för detta spel. Åtgärdar svarta bakgrunder. Stöder PNG, JPG, JPEG, WebP, SVG."
          }
        },
        "zh-Hans": {
