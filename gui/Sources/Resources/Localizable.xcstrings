    "ipa_health.warn_subtitle_multi": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Veraltete oder beschädigte .ipa-Dateien führen zu Hängern. In den Papierkorb verschieben, neu portieren und alle Spiele übertragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outdated or corrupted .ipa packages cause +30 min delays or 15% freezes. Remove the failed .ipa(s) to Trash, re-port preserving shader caches, and deploy all selected games."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los paquetes .ipa obsoletos o dañados provocan retrasos o bloqueos. Mueve los .ipa fallidos a la Papelera, vuelve a portar conservando shaders y despliega todos los juegos seleccionados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paquets .ipa obsolètes ou corrompus causent des blocages. Supprimez-les vers la Corbeille, re-portez en gardant les shaders et déployez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pacchetti .ipa obsoleti o danneggiati causano blocchi. Spostali nel Cestino, ri-porta mantenendo gli shader e installa tutti i giochi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いまたは破損した .ipa は長時間の遅延や停止の原因になります。ゴミ箱に移動して再移植し、全ゲームを一括転送してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오래되었거나 손상된 .ipa는 멈춤 현상을 유발합니다. 휴지통으로 이동하고 셰이더 캐시를 유지한 채 재이식하여 전송하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przestarzałe lub uszkodzone pakiety powodują błędy. Usuń je do Kosza, zrekompiluj zachowując shadery i zainstaluj gry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacotes .ipa desatualizados ou corrompidos causam demora de +30 min ou travamento em 15%. Remova os .ipa(s) falhos, gere novos ports preservando caches e envie em Multi-Port."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacotes .ipa desatualizados ou corrompidos causam demora de +30 min ou travamento em 15%. Remova os .ipa(s) falhos, gere novos ports preservando caches e envie em Multi-Port."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поврежденные пакеты вызывают сбои. Удалите их в Корзину, пересоберите с сохранением кэша и установите игры."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Föråldrade paket orsakar problem. Flytta dem till papperskorgen, porta om med bevarade shaders och överför spelen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过期或损坏的安装包会导致卡死。移至废纸篓并保留着色器重新移植，一键部署所选游戏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過期或損毀的安裝套件會造成卡死。移至垃圾桶並保留著色器重新移植，一鍵部署所選遊戲。"
          }
        }
      }
    },
    "ipa_health.warn_subtitle_single": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses .ipa verursacht Verzögerungen von +30 Min oder stoppt bei 15%%. NxNative Launcher kann es in den Papierkorb verschieben (Shader-Caches bleiben erhalten), neu portieren und übertragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This .ipa causes 30+ min delays or fails at 15%. NxNative Launcher can move the failed .ipa to Trash (keeping compiled shader caches), build a fresh .ipa, and deploy it automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este .ipa causa demoras de +30 min o se bloquea en 15%. NxNative Launcher puede mover el .ipa a la Papelera (conservando los shaders), crear un nuevo port .ipa y enviarlo según tu elección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce .ipa provoque des retards de +30 min ou échoue à 15%%. NxNative Launcher peut le déplacer vers la Corbeille (en conservant les shaders), le reconstruire et le déployer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo .ipa causa ritardi di oltre 30 min o si blocca al 15%%. NxNative Launcher può spostarlo nel Cestino (mantenendo la cache shader), ricompilarlo e installarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この .ipa は30分以上の遅延や15%%でのフリーズを引き起こします。問題のある .ipa をゴミ箱に移動し（シェーダーキャッシュは保持）、新規ビルドして自動転送できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 .ipa는 30분 이상 지연되거나 15%%에서 멈춥니다. 실패한 .ipa를 휴지통으로 이동(셰이더 캐시는 유지)하고 새 .ipa를 자동 배포할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten .ipa powoduje opóźnienia powyżej 30 min lub zatrzymuje się na 15%%. Przenieś go do Kosza (shadery zostaną zachowane), skompiluj ponownie i wyślij automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este .ipa causa demora de +30 min ou trava em 15%. O NxNative Launcher pode mover o .ipa falho para o Lixo (preservando os shaders em cache), gerar um novo port .ipa e enviar na opção escolhida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este .ipa causa demora de +30 min ou bloqueia em 15%. O NxNative Launcher pode mover o .ipa para o Lixo (preservando os shaders em cache), gerar um novo port .ipa e enviar na opção escolhida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот .ipa вызывает зависания на 15%% или задержки. Переместите его в Корзину (шейдеры сохранятся), соберите заново и отправьте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna .ipa orsakar fördröjningar på +30 min eller hänger sig vid 15%%. Flytta den till papperskorgen (shaders bevaras), bygg om och distribuera automatiskt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 .ipa 会导致 30+ 分钟延迟或在 15%% 时卡死。NxNative Launcher 可将其移至废纸篓（保留着色器缓存），重新构建并自动部署。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 .ipa 會導致 30+ 分鐘延遲或在 15%% 時卡死。NxNative Launcher 可將其移至垃圾桶（保留著色器快取），重新建置並自動部署。"
          }
        }
      }
    },
