    "build.apple_clt_dialog": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das offizielle Apple-Installationsdialogfeld wurde geöffnet. Befolgen Sie die Anweisungen. Klicken Sie danach auf 'Erneut prüfen'."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's official installer dialog has opened on screen. Follow Apple's prompt to complete the installation. Once finished, click 'Re-check' to verify."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha abierto el diálogo del instalador oficial de Apple. Siga las instrucciones para completar la instalación. Al finalizar, haga clic en 'Volver a comprobar'."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La boîte de dialogue officielle d'Apple est ouverte. Suivez les instructions pour terminer l'installation, puis cliquez sur 'Vérifier à nouveau'."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stata aperta la finestra di installazione ufficiale di Apple. Segui le istruzioni. Al termine, fai clic su 'Ricontrolla'."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple の公式インストーラーが開きました。画面の指示に従ってインストールを完了し、完了後に「再確認」をクリックしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 공식 설치 대화상자가 열렸습니다. 설치를 완료한 후 '다시 확인'을 클릭하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwarto oficjalne okno instalatora Apple. Postępuj zgodnie z instrukcjami, a po zakończeniu kliknij 'Sprawdź ponownie'."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela do instalador oficial da Apple foi aberta. Siga as instruções para concluir. Quando terminar, clique em 'Verificar Novamente'."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela do instalador oficial da Apple foi aberta. Siga as instruções para concluir. Quando terminar, clique em 'Verificar Novamente'."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыто окно официального установщика Apple. Следуйте инструкциям, затем нажмите 'Перепроверить'."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples officiella installationsdialogruta har öppnats. Följ anvisningarna för att slutföra installationen. Klicka sedan på ”Kontrollera igen” för att verifiera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 官方安装器窗口已打开。请按照提示完成安装，完成后点击“重新检查”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 官方安裝程式視窗已開啟。請依照提示完成安裝，完成後按一下「重新檢查」。"
          }
        }
      }
    },
