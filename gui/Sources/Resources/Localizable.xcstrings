    "build.platform_android_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Builds a standalone Android APK with native Vulkan graphics support."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gera um APK independente para Android com suporte nativo a gráficos Vulkan."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gera um APK independente para Android com suporte nativo a gráficos Vulkan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera un APK independiente para Android con soporte nativo de gráficos Vulkan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Génère un APK autonome pour Android avec prise en charge graphique Vulkan native."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt ein eigenständiges Android-APK mit nativer Vulkan-Grafikunterstützung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera un APK autonomo per Android con supporto grafico nativo Vulkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブVulkanグラフィックス対応のスタンドアロンAndroid APKを生成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브 Vulkan 그래픽을 지원하는 독립 실행형 Android APK를 빌드합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建支持原生 Vulkan 图形的独立 Android APK 安装包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "構建支援原生 Vulkan 圖形的獨立 Android APK 安裝包。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompiluje samodzielny pakiet APK dla Androida z natywną grafiką Vulkan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создает автономный Android APK с нативной графикой Vulkan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygger en fristående Android-APK med inbyggd Vulkan-grafik."
          }
        }
      }
    },
