    "settings.ios_sync_config_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Spieleinstellungen, FPS/FrameGen, Upscaler und Sprache ohne Neubau an das verbundene iPhone/iPad senden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send current game preset, FPS/FrameGen, upscaler and language settings to the connected iPhone/iPad without rebuilding"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía el perfil actual, FPS/FrameGen, upscaler e idioma del juego al iPhone/iPad conectado sin recompilar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer le préréglage, le FPS/FrameGen, l'upscaler et la langue à l'iPhone/iPad connecté sans recompiler"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia il profilo attuale, FPS/FrameGen, upscaler e lingua a iPhone/iPad collegato senza ricompilare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再ビルドすることなく、現在のプリセット、FPS/FrameGen、アップスケーラー、言語設定を接続されたiPhone/iPadに送信します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 빌드할 필요 없이 현재 프리셋, FPS/FrameGen, 업스케일러 및 언어 설정을 연결된 iPhone/iPad로 전송합니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyła bieżący profil, FPS/FrameGen, upscaler i język do podłączonego iPhone'a/iPada bez rekompilacji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia o preset atual, FPS/FrameGen, upscaler e idioma do jogo para o iPhone/iPad conectado sem recompilar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia a predefinição atual, FPS/FrameGen, upscaler e idioma do jogo para o iPhone/iPad ligado sem recompilar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет текущий профиль, FPS/FrameGen, апскейлер и язык на подключенный iPhone/iPad без пересборки"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka aktuell profil, FPS/FrameGen, uppskalare och språk till ansluten iPhone/iPad utan att bygga om"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需重新编译，即可将当前预设、帧率/插帧、超分辨率和语言设置发送到已连接的 iPhone/iPad"
          }
        },
        "zh-Hant": {
