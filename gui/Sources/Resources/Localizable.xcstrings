    "updates.instructions_existing_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Da .app-Bundles eigenständig sind, klicken Sie auf 'Erneut portieren' im Spielordner, um die neue dmhost-Engine, 60-FPS-Videos und Auflösungs-Overlays zu erhalten. Da Shader-Cache und entpackte Assets erhalten bleiben, dauert der Rebuild nur 1–2 Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Since macOS .app bundles are self-contained, to receive the new dmhost executable, 60 FPS cutscenes, and resolution overlay, click 'Port Again' on the game folder. Because extraction and shader cache are preserved, rebuilding takes only 1 to 2 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dado que el paquete (.app) es independiente, para recibir el nuevo ejecutable dmhost, cinemáticas a 60 FPS y overlay de resolución, haz clic en 'Portar de nuevo'. Al conservarse la caché de shaders, reconstruir toma solo 1 o 2 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme le paquet (.app) est autonome, pour obtenir le nouvel exécutable dmhost, les cinématiques 60 FPS et l'overlay de résolution, cliquez sur 'Porter à nouveau'. Le cache de shaders étant conservé, la reconstruction ne prend que 1 à 2 minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poiché il bundle (.app) è indipendente, per ricevere il nuovo eseguibile dmhost, i video a 60 FPS e l'overlay di risoluzione, clicca su 'Porta di nuovo'. Conservando la cache di shader ed estrazione, la ricostruzione richiede solo 1 o 2 minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSの.appバンドルは独立しているため、新しいdmhost実行ファイル、60 FPSカットシーン、解像度オーバーレイを受け取るには、ゲームフォルダで「再移植」をクリックしてください。シェーダーキャッシュが保持されているため、再ビルドはわずか1〜2分で完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS .app 번들은 독립적이므로 새 dmhost 실행 파일, 60 FPS 컷신 및 해상도 오버레이를 적용하려면 게임 폴더에서 '다시 포팅'을 클릭하세요. 셰이더 캐시가 유지되므로 다시 빌드하는 데 1~2분밖에 걸리지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponieważ paczki (.app) są niezależne, aby otrzymać nowy plik dmhost, przerywniki w 60 FPS i nakładkę rozdzielczości, kliknij 'Portuj ponownie'. Dzięki zachowaniu pamięci podręcznej shaderów ponowna kompilacja trwa zaledwie 1–2 minuty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como o bundle (.app) é independente, para receber o novo executável dmhost, os vídeos a 60 FPS e o overlay de resolução, clique em 'Portar novamente' na pasta do jogo. Como o cache de extração e shaders é preservado, o re-build dura cerca de 1 a 2 minutos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Como o bundle (.app) é independente, para receber o novo executável dmhost, os vídeos a 60 FPS e o overlay de resolução, clique em 'Portar novamente' na pasta do jogo. Como a cache de extração e shaders é preservada, a reconstrução dura cerca de 1 a 2 minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так как пакет .app полностью автономен, для получения нового dmhost, катсцен в 60 FPS и оверлея разрешения нажмите 'Портировать снова'. Кэш шейдеров сохраняется, поэтому пересборка занимает всего 1–2 минуты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Eftersom .app-paketet är självständigt klickar du på 'Porta igen' i spelmappen för att få den nya dmhost-motorn, 60 FPS-videor och upplösningsöverlägg. Eftersom shader-cachen bevaras tar ombyggnaden bara 1–2 minuter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于 macOS 的 .app 是完全独立的自包含包，若要获取最新的 dmhost 执行程序、60 FPS 过场动画和分辨率覆盖层，只需在游戏文件夹中点击“重新移植”。由于解包与着色器缓存均已保留，重新构建仅需 1 到 2 分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於 macOS 的 .app 是完全獨立的自包含包，若要獲取最新的 dmhost 執行程式、60 FPS 過場動畫和解析度覆蓋層，只需在遊戲資料夾中點擊「重新移植」。由於解包與著色器快取均已保留，重新建置僅需 1 到 2 分鐘。"
          }
        }
      }
    },
