    "system.patches_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorkonfigurierte Patches für 60 FPS-Freischaltung, UE-Speicherzuweiser, Shader-Fallbacks und Mac-App-Packaging."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre-configured patches for 60 FPS unlock, UE memory allocators, dynamic shader fallbacks, and Mac app packaging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parches preconfigurados para 60 FPS, asignadores UE, shaders dinámicos y empaquetado para Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Patchs préconfigurés pour débloquer le 60 FPS, allocateurs mémoire UE, shaders dynamiques et packaging Mac."
          }
        },
        "it": {
