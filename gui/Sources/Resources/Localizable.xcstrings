    "system.ported_library_folder_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zielordner, in dem portierte Spiele kompiliert und gespeichert werden (.app für Mac und .ipa für iOS), und aus dem der Launcher Ihre Bibliothek lädt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target directory where ported games are compiled and saved (.app for Mac and .ipa for iOS), and from where the launcher reads your My Games library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Directorio de destino donde se compilan y guardan los juegos portados (.app para Mac e .ipa para iOS), y desde donde el launcher lee tu biblioteca My Games."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossier cible où les jeux portés sont compilés et enregistrés (.app pour Mac et .ipa pour iOS), et d'où le lanceur lit votre bibliothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartella di destinazione dove vengono compilati e salvati i giochi (.app per Mac e .ipa per iOS), e da dove il launcher legge la tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移植されたゲームが保存される出力先（Mac用 .app および iOS用 .ipa）。ランチャーはこの場所からマイゲームを読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이식된 게임이 컴파일되어 저장되는 대상 디렉토리(Mac용 .app 및 iOS용 .ipa). 런처가 보관함을 로드하는 위치입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder docelowy, w którym są zapisywane skompilowane gry (.app na Maca i .ipa na iOS), z którego launcher odczytuje Twoją bibliotekę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diretório onde os novos jogos portados são compilados e salvos (.app para Mac e .ipa para iOS), e de onde o launcher carrega a sua biblioteca My Games."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Diretório onde os novos jogos convertidos são compilados e guardados (.app para Mac e .ipa para iOS)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка назначения, где компилируются и сохраняются портированные игры (.app для Mac и .ipa для iOS), откуда лаунчер загружает вашу библиотеку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Målmapp där portade spel sparas (.app för Mac och .ipa för iOS), och varifrån launchern läser in ditt bibliotek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移植游戏编译并保存的目标目录（Mac 版 .app 和 iOS 版 .ipa），启动器会从此目录读取您的“我的游戏”游戏库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已移植遊戲編譯並儲存的目標目錄（Mac 版 .app 和 iOS 版 .ipa），啟動器會從此目錄讀取您的「我的遊戲」遊戲庫。"
          }
        }
      }
    },
