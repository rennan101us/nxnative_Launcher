          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Travado em ATIVADO: O app macOS nativo executa diretamente a partir dos assets extraídos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado em ATIVADO: A aplicação macOS nativa executa diretamente a partir dos assets extraídos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокировано: нативное приложение macOS запускается прямо из извлечённых ресурсов игры."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
