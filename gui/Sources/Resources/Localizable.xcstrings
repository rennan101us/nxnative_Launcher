    "settings_modal.developer_mode_tip": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere beim ersten Mal den Entwicklermodus auf dem Gerät und vertraue dem Entwickler (Einstellungen → Allgemein → VPN und Geräteverwaltung)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first time, turn on Developer Mode on the device and trust the developer (Settings → General → VPN & Device Management)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera vez, activa el Modo Desarrollador en el dispositivo y confía en el desarrollador (Ajustes → General → Gestión de VPN y dispositivos)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première fois, activez le mode développeur sur l'appareil et faites confiance au développeur (Réglages → Général → Gestion des VPN et des appareils)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prima volta, attiva la modalità sviluppatore sul dispositivo e autorizza lo sviluppatore (Impostazioni → Generali → Gestione VPN e dispositivi)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回はデバイスのデベロッパモードを有効にし、開発者を信頼してください ([設定] → [一般] → [VPNとデバイス管理])。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 설치할 때는 기기에서 개발자 모드를 켜고 개발자를 신뢰하십시오 (설정 → 일반 → VPN 및 기기 관리)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za pierwszym razem włącz Tryb Dewelopera na urządzeniu i zaufaj deweloperowi (Ustawienia → Ogólne → VPN i zarządzanie urządzeniami)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na primeira vez, ative o Modo de Desenvolvedor no dispositivo e confie no desenvolvedor (Ajustes → Geral → VPN e Gestão de Dispositivos)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Na primeira vez, ative o Modo de Desenvolvedor no dispositivo e confie no desenvolvedor (Ajustes → Geral → VPN e Gestão de Dispositivos)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При первой установке включите Режим разработчика на устройстве и доверьтесь сертификату (Настройки → Основные → VPN и управление устройством)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera utvecklarläge på enheten vid första installationen och lita på utvecklaren (Inställningar → Allmänt → VPN och enhetshantering)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次安装请在设备上开启开发者模式并信任开发者证书 (设置 → 通用 → VPN 与设备管理)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次安裝請在裝置上開啟開發者模式並信任開發者憑證 (設定 → 一般 → VPN 與裝置管理)。"
          }
        }
      }
    },
