    "settings.ios_custom_cert_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren Sie ein externes Entwicklerzertifikat (.p12) und ein Bereitstellungsprofil (.mobileprovision) für Sideloading oder Drittanbieter-Konten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import external Developer Certificate (.p12) and Provisioning Profile (.mobileprovision) for sideloading or third-party signing accounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un certificado de desarrollador externo (.p12) y perfil de aprovisionamiento (.mobileprovision) para sideloading o cuentas de terceros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez un certificat de développeur externe (.p12) et un profil de provisionnement (.mobileprovision) pour le sideloading ou des comptes tiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa certificato sviluppatore esterno (.p12) e profilo di provisioning (.mobileprovision) per il sideloading o account di terze parti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドロードまたはサードパーティ署名アカウント用の外部開発者証明書 (.p12) およびプロビジョニング プロファイル (.mobileprovision) をインポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드로딩 또는 타사 서명 계정을 위해 외부 개발자 인증서(.p12) 및 프로비저닝 프로파일(.mobileprovision)을 가져옵니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaimportuj zewnętrzny certyfikat programisty (.p12) i profil aprowizacji (.mobileprovision) do sideloadingu lub kont zewnętrznych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe Certificado de Desenvolvedor externo (.p12) e Perfil de Provisionamento (.mobileprovision) para sideloading ou contas de terceiros."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe Certificado de Programador externo (.p12) e Perfil de Provisionamento (.mobileprovision) para sideloading ou contas de terceiros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте внешний сертификат разработчика (.p12) и профиль обеспечения (.mobileprovision) для sideloading или сторонних аккаунтов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Importera externt utvecklarcertifikat (.p12) och tillhandahållandeprofil (.mobileprovision) för sideloading eller tredjepartskonton."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入用于侧载或第三方签名账户的外部开发者证书 (.p12) 和配置文件 (.mobileprovision)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入用於側載或第三方簽名帳戶的外部開發者憑證 (.p12) 和描述檔 (.mobileprovision)。"
          }
        }
      }
    },
