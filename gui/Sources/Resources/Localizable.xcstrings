    "build.romfs_split_recommendation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Großes Spiel erkannt (~%@): Sideloading-Tools scheitern oft an riesigen IPAs. Getrenntes RomFS wird dringend empfohlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large Game Detected (~%@): Sideloading tools often fail on huge IPAs. Enabling Separate RomFS is strongly recommended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juego grande detectado (~%@): Las herramientas de instalación suelen fallar con IPAs gigantes. Se recomienda activar RomFS separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeu volumineux détecté (~%@) : Les outils de sideload échouent souvent sur les gros IPA. Il est fortement recommandé d'activer RomFS séparé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilevato gioco di grandi dimensioni (~%@): Gli strumenti di sideloading spesso falliscono con IPA enormi. Si consiglia vivamente di attivare RomFS separato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大容量ゲームを検出 (~%@): サイドロードツールは巨大な IPA で失敗しがちです。RomFS 分離を強く推奨します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대용량 게임 감지됨 (~%@): 사이드로딩 도구는 대용량 IPA에서 오류가 발생하기 쉽습니다. RomFS 분리를 적극 권장합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykryto dużą grę (~%@): Narzędzia instalacyjne często zawodzą przy ogromnych plikach IPA. Zalecane jest oddzielenie RomFS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogo Grande Detectado (~%@): Ferramentas de sideloading frequentemente falham em IPAs gigantes. Recomendamos ativar RomFS Separado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogo Grande Detectado (~%@): Ferramentas de sideloading frequentemente falham em IPAs gigantes. Recomendamos ativar RomFS Separado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаружена большая игра (~%@): Инструменты установки часто дают сбой на огромных IPA. Настоятельно рекомендуется отдельный RomFS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stort spel upptäckt (~%@): Sidladdningsverktyg misslyckas ofta med enorma IPA-filer. Separat RomFS rekommenderas starkt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到大型游戏 (~%@)：自签名安装工具通常在超大 IPA 上失败。强烈建议启用 RomFS 分离。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測到大型遊戲 (~%@)：側載工具通常在超大 IPA 上失敗。強烈建議啟用 RomFS 分離。"
          }
        }
      }
    },
