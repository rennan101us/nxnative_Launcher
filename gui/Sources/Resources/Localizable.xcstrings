        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ネイティブ移植のコンパイルには Apple の開発ツールが必要です。1クリックでインストールできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 네이티브 포트를 빌드하려면 Apple 컴파일러가 필요합니다. 한 번의 클릭으로 설치하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompilatory Apple są wymagane do budowy portów Mac. Zainstaluj jednym kliknięciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
