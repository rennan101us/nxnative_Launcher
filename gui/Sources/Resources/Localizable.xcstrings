    "settings_modal.oot_framegen_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzeugt Zwischenbilder zur Verdoppelung der Bildrate auf 60/120 FPS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doubles game framerate (30 to 60 FPS or 60 to 120 FPS)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera fotogramas interpolados para duplicar la fluidez visual a 60/120 FPS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Génère des images interpolées pour doubler la fluidité à 60/120 FPS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera fotogrammi interpolati per raddoppiare la fluidità a 60/120 FPS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "補間フレームを生成し、滑らかな 60/120 FPS を実現します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보간 프레임을 생성하여 시각적 부드러움을 60/120 FPS로 두 배 향상합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Generuje klatki pośrednie, podwajając płynność do 60/120 FPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobra a taxa de quadros do jogo (30 para 60 FPS ou 60 para 120 FPS)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplica a taxa de fotogramas do jogo (30 para 60 FPS ou 60 para 120 FPS)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создает промежуточные кадры, удваивая плавность до 60/120 FPS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Genererar interpolerade bildrutor för att fördubbla flytet till 60/120 FPS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成插帧以使视觉流畅度倍增至 60/120 FPS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "生成內插畫格，讓視覺流暢度倍增至 60/120 FPS。"
          }
        }
      }
    },
