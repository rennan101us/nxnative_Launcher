    "settings_modal.game_mode_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorisiert CPU- und GPU-Leistung auf Apple Silicon und reduziert Controller- und Audio-Latenz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritizes CPU and GPU performance on Apple Silicon, reducing controller and audio latency."
          }
        },
        "es": {
