    "updates.changelog_oot_memory": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicheroptimierung für 16-GB-Macs: Rendertargets mit Metal-Verlustkompression (rt_lossy), sofortige Freigabe von Texturspeicherseiten (DM_TEX_RELEASE=2) und Unterdrückung ausgemusterter Texturpools."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory Management for 16 GB Macs: Color render targets with Metal lossy compression (rt_lossy), immediate deallocation of guest texture memory pages (DM_TEX_RELEASE=2), and retired texture pool suppression (pool_skip_retired)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestión de Memoria para Macs de 16 GB: Render targets con compresión Metal lossy (rt_lossy), liberación inmediata de texturas invitadas (DM_TEX_RELEASE=2) y supresión de texturas retiradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestion de mémoire pour Macs 16 Go : Cibles de rendu avec compression Metal avec perte (rt_lossy), libération immédiate des textures (DM_TEX_RELEASE=2) et suppression des pools retirés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestione memoria per Mac da 16 GB: Render target con compressione lossy Metal (rt_lossy), rilascio immediato della memoria texture guest (DM_TEX_RELEASE=2) e soppressione pool ritirati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "16 GB Mac向けメモリ管理：Metal非可逆圧縮レンダーターゲット (rt_lossy)、テクスチャ転送後の即時メモリ解放 (DM_TEX_RELEASE=2)、破棄テクスチャプールの抑制。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "16 GB Mac을 위한 메모리 관리: Metal 손실 압축 렌더 타깃(rt_lossy), 텍스처 전송 후 게스트 메모리 즉시 해제(DM_TEX_RELEASE=2), 폐기 텍스처 풀 억제."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzanie pamięcią dla Maców 16 GB: Render targety z kompresją stratną Metal (rt_lossy), natychmiastowe zwalnianie stron tekstur (DM_TEX_RELEASE=2) i tłumienie wycofanych pul tekstur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerenciamento de Memória para Macs 16 GB: Render targets com compressão Metal lossy (rt_lossy), descarte imediato de páginas de texturas enviadas (DM_TEX_RELEASE=2) e supressão de texturas retiradas (pool_skip_retired)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestão de Memória para Macs 16 GB: Render targets com compressão Metal lossy (rt_lossy), libertação imediata de páginas de texturas enviadas (DM_TEX_RELEASE=2) e supressão de texturas retiradas (pool_skip_retired)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управление памятью для Mac с 16 ГБ: Цели рендеринга со сжатием Metal lossy (rt_lossy), немедленное освобождение гостевых страниц текстур (DM_TEX_RELEASE=2) и подавление устаревших текстурных пулов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minneshantering för 16 GB Mac-datorer: Rendringsmål med Metal lossy-komprimering (rt_lossy), omedelbar frigöring av textursidor (DM_TEX_RELEASE=2) och poolundertryckning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "16 GB Mac 内存优化：采用 Metal 有损压缩渲染目标 (rt_lossy)、纹理上传后立即释放 Guest 内存 (DM_TEX_RELEASE=2) 并抑制退役纹理池。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "16 GB Mac 記憶體最佳化：採用 Metal 有損壓縮彩現目標 (rt_lossy)、紋理上傳後立即釋放 Guest 記憶體 (DM_TEX_RELEASE=2) 並抑制退役紋理池。"
          }
        }
      }
    },
    "updates.changelog_oot_metalfx": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX Spatial Upscaler: Ersetzt den aufwendigen 6-Pass-Compute-Upscaler durch natives MetalFX unter macOS Tahoe (Metal 4) für reduzierte GPU-Last bei 60+ FPS."
          }
        },
        "en": {
          "stringUnit": {
