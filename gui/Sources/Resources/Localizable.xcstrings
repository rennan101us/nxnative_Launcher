    "build.apple_tools_missing_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-Compiler sind erforderlich, um native Mac-Ports zu erstellen. Mit 1 Klick installieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple developer compilers are required to build native Mac ports. Install with 1 click."
